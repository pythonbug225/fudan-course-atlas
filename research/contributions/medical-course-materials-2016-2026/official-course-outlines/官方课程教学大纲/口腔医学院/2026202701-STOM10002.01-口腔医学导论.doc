<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="151">
<p>口腔修复学（2）</p>
</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="236">
