</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="44">
<p>2</p>
</td>
</tr>
<tr>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="170">
