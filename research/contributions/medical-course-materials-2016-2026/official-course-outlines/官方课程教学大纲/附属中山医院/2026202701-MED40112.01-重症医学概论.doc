</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="59">
<p>18</p>
</td>
