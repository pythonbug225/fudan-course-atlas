            <tr style="height:176.7000pt;">
                <td width=777 valign=center colspan=14 style="width:466.7000pt;padding:0.0000pt 5.4000pt 0.0000pt 5.4000pt ;border-left:1.0000pt solid windowtext;
mso-border-left-alt:0.5000pt solid windowtext;border-right:1.0000pt solid windowtext;mso-border-right-alt:0.5000pt solid windowtext;
border-top:none;mso-border-top-alt:0.5000pt solid windowtext;border-bottom:1.0000pt solid windowtext;
mso-border-bottom-alt:0.5000pt solid windowtext;">
                    <p class=MsoNormal><span style="font-family:仿宋;mso-bidi-font-family:'Times New Roman';font-size:12.0000pt;
mso-font-kerning:1.0000pt;"><font face="仿宋"><table style="border-collapse: collapse; border-color: #ccc; border: 1px solid #000000;" border="1">
<tbody>
<tr>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="626">
<p><strong>教学内容安排 </strong>（具体到每节课内容）<strong>：</strong></p>
<table style="border-collapse: collapse; border-color: #ccc; border: 1px solid #000000;" border="1">
<tbody>
<tr>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="102">
<p><strong>周次</strong></p>
</td>
<td style="padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; padding: 0.4rem; border: 1px solid #000000;" width="48">
<p><strong>学时</strong></p>
</td>
