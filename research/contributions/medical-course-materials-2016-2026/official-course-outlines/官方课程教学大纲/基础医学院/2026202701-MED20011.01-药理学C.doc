<td style="padding: 0.4rem; padding: 0.4rem; width: 77.8594px; border: 1px solid #000000;">　</td>
</tr>
<tr>
<td style="padding: 0.4rem; padding: 0.4rem; width: 40.7188px; border: 1px solid #000000;">　</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 56.4688px; border: 1px solid #000000;">12.22</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 40.7188px; border: 1px solid #000000;">二</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 49.5312px; border: 1px solid #000000;">3,4</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 277.562px; border: 1px solid #000000;">抗肿瘤药</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 73.6719px; border: 1px solid #000000;">　</td>
<td style="padding: 0.4rem; padding: 0.4rem; width: 77.8594px; border: 1px solid #000000;">　</td>
</tr>
