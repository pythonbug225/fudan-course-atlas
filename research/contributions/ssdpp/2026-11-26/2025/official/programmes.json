  {
    "plan_id": "96705",
    "cohort": 2025,
    "title": "2025社会学-社会学本博融通培养方案（社会学博英班）",
    "department": "社会发展与公共政策学院",
    "department_id": 2567,
    "major_name": "社会学",
    "directory_row": {
      "YEARS": "2025",
      "MAJOR_NAME": "社会学",
      "MAJOR_ID": 374,
      "DEPART_NAME": "社会发展与公共政策学院",
