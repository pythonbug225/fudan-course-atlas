  "student_reviews_and_discussions": [
    {
      "source_id": "DANKE-571",
      "summary": "评论者描述课程围绕数部不同时期小说讲叙事发展史，含每周阅读和思考作业、部分英文材料以及3000—5000字中文期末论文；其估计平时与期末论文各占一半。作者称思考题曾占用较多时间，但觉得教师会回应学生思路，文本细读带来很强的发现感；表示无需文学理论基础。",
      "teacher": "段枫",
      "term": "2022秋"
    },
    {
      "source_id": "DANKE-720",
      "summary": "评论者称课程主要讲叙事学及多部文学作品，与漫威主题关系不大；即使其英语基础较好、当时课业较轻，仍觉得阅读和作业量大，且认为期末论文要求较高。",
      "teacher": "段枫",
      "term": "2022秋"
    },
    {
      "source_id": "DANKE-3420",
      "summary": "评论者建议对西方文学感兴趣者选修，称除认真阅读外较清闲、整体体验不错。",
      "teacher": "段枫",
      "term": "2024秋"
    }
  ],
