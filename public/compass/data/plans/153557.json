dCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MSP50003","name":"当代中国社会","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"AIS631008","name":"大数据与社会计算","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SWK50008","name":"比较社会政策","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"AIS631009","name":"人工智能、数据挖掘与算法：社会研究方法的新范式","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]},{"id":"-101","rawId":"-101","parent":null,"level":"1.1.1","title":"荣誉项目路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"荣誉项目课程设置和修读要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"35","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"本路径学生需要完成147学分，包括通识教育课程38学分、专业培养课程64学分、专业进阶模块17学分、融合创新能力模块13学分、修读1个跨学科学程（微专业）。修读学分不足部分可在全校所有本科生课程中任意选修。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"35","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"本路径学生需要完成147学分，包括通识教育课程38学分、专业培养课程54学分、专业进阶模块25学分、融合创新能力模块11学分, 修读1个创新创业学院开设的创新创业学程15学分。修读学分不足部分可在全校所有本科生课程中任意选修。创新创业学程课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求至少修读1个本专业进阶课程模块和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。 \n        辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~24","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":13.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"13","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1.\t按照“基础能力筑基—分支领域深化—创新实践突破” 渐次推进、相互衔接的社会工作教学体系，在分析社会问题、回应个体、人际和社区需求的过程中培养实践能力，训练批判性思维，激发社会工作学术研究的潜力。\n2.\t全周期的科研训练体系，1年级为科研启蒙阶段，以知识传授为主；2-3年级为科研项目孵化阶段，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣；4年级为成果转化阶段。\n3.\t多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛、“中社杯”社会服务技能大赛、“互联网+”创新创业大赛等）。","reference":false,"referenceId":null,"courses":[{"code":"SOCI40003","name":"学年论文","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SWK40001","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SWK50021","name":"论文写作实训","credits":2.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SWK60004","name":"社会工作专业实习","credits":6.0,"required":false,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":88,"completeModules":true,"fetchedAt":"2026-10-31T16:45:01Z","programNotes":[{"title":"学科专业简介","text":"复旦大学社会工作学系是国家级一流本科专业建设点，社会工作专业硕士A+学科学位点，同时拥有社会工作科学硕士、专业硕士（MSW）学位授予权，社会学一级学科社会工作二级博士点，社会工作专业博士（DSW）学位点已通过学校审批。复旦的社会工作专业一直在全国名列前茅，依托上海社会工作发展的区位优势和复旦大学深厚的人文底蕴，专业人才培养质量高，行业声誉优良。随着国家对社会治理的重视，以及人们对社会福祉的不断追求，社会工作专业和职业发展前景广阔。"},{"title":"培养目标","text":"&nbsp; &nbsp; 秉持知行合一、价值引领与技术创新融通的培养理念，注重培育学生具有国际前沿的学科视野和扎根本土的社会服务情怀，构建社会工作伦理、理论与实务技能三位一体的知识体系，强化大数据分析、智能技术应用等数字化工具的训练；使学生坚守专业伦理，立足中国社会转型的现实需求，运用社会工作的价值理念、理论和科学方法，推动基层治理现代化，促进社会公平正义，提升个体福祉。\n&nbsp; &nbsp; 按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展，掌握人文社会科学知识和社会工作理论与技能，能在政府民生服务和社会管理部门、境内外社会组织和公益机构、企业人力资源部门、媒体社会事务版块，从事政策研究、项目开发与管理、直接服务、专业评估等工作的应用型专门人才。"},{"title":"基本要求","text":"要求学生树立以人为本、助人自助、公平公正的专业伦理，领悟社会工作的专业理论和研究方法，掌握社会管理和社会服务方法与技能；熟悉国家方针政策、法律和法规；善于分析社会问题和解决社会问题，具有较强的论文写作和语言表达能力；熟练掌握一门外语。整体具备良好的专业核心能力和科学研究能力。"},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：√本科、□本硕、□本博）\n&nbsp;\n&nbsp;\n\n\n2. 学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n法学学士\n/\n社会工作\n□按照不少于总学分比例____%\n\n\n◾️按照不少于学分数 &nbsp;132（参考社工“2+X+Y”方案）\n\n\n◾️必修课组须通过\n通识教育课程38学分\n\n\n专业培养课程64学分\n\n\n专业进阶模块17学分\n\n\n融合创新能力模块13学分\n\n\n□其他____________________\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 本专业学生毕业时须满足通识教育课程（含通识教育核心课程和专项教育课程）38学分、专业培养课程64学分、融合创新能力模块13学分和多元发展路径课程的修读要求，总学分不低于132学分（含实践学分不低于31.5学分、含美育学分不少于2学分、劳动教育不少于32学时，并满足劳动周教育要求），达到学位要求者授予法学学士学位。留学生和港澳台侨学生的通识教育课程修读要求，以及留学生的水平测试要求，参见“留学生和港澳台侨学生修读说明”。\n\n\n"},{"title":"学分要求","text":"\n\n\n\n1、&nbsp;专业进阶路径：132学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;本路径学生需要完成132学分，包括通识教育课程38学分、专业培养课程64学分、专业进阶模块17学分、融合创新能力模块13学分。不足部分的学分可通过选修非本专业独立学程及任意选修全校所有本科生课程等组合的形式完成。原则上，修完除学年论文和毕业论文以外的所有专业核心课程、且修完专业进阶课程14学分或以上的社会工作学系本科生，可以向社会发展与公共政策学院申请专业排名和推免候选机会。\n\n\n2、&nbsp;本科荣誉项目：139学分\n\n\n&nbsp;&nbsp;&nbsp; 在专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见社会发展与公共政策学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。&nbsp;\n\n\n3、&nbsp;跨学科学发展路径：147学分\n\n\n&nbsp;&nbsp; 本路径学生需要完成147学分，包括通识教育课程38学分、专业培养课程64学分、专业进阶模块17学分、融合创新能力模块13学分、修读1个跨学科微专业（学程）15学分。修读学分不足部分可在全校所有本科生课程中任意选修。\n\n\n4.创新创业路径：147学分\n\n\n&nbsp;本路径学生需要完成147学分，包括通识教育课程38学分、专业培养课程64学分、专业进阶模块17学分、融合创新能力模块13学分,&nbsp;修读1个创新创业学院开设的创新创业学程15学分。修读学分不足部分可在全校所有本科生课程中任意选修。创新创业学程课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n\n\n5、社会学+AI双学士学位项目\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;具体要求见社会工作-人工智能双学士学位项目培养方案。&nbsp;\n\n\n6、辅修学士学位路径\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;要求至少修读1个本专业进阶课程模块和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。\n\n\n其他：\n\n\n*：多元发展路径中，专业进阶课程模块均可以冲抵学程，专业培养和多元发展路径共享的课程只计算一次学分。\n\n\n**：留学生和港澳台侨学生的通识教育课程修读要求，以及留学生的水平测试要求，参见相应修读说明。\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n1. 4年级结束时，如达到学士学位要求者理授予法学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到社会工作学系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。\n\n\n2. 社会工作+AI学士双学位项目，如达到社会工作-人工智能双学士学位要求者授予法学-工学双学士学位。\n\n\n"},{"title":"课程体系与科研训练体系","text":"1、课程体系\n\n2、实践训练体系\n&nbsp; 建立螺旋递进的全周期实务与科研训练体系。给低年级本科生配备学业导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。从2年级开始开设大量的社会工作分支领域课程，鼓励学生接触前沿实践和研究，并选择自己感兴趣的实践方向。3年级开始设有专业实习，实行双督导制，致力于增强学生应对复杂治理问题的实践经验和专业素养，提升就业竞争力与胜任力。双督导拟由学术导师（专任教师）与行业导师（政府、医院、学校、基金会、社会服务机构、企业社会责任部等业内人士）组成。\n&nbsp; &nbsp; 鼓励学生参加国内外高水平创新竞赛，以赛促教、促学、促研。鼓励学生在本科阶段第三学年末或第四学年初规定时间以“队长/项目负责人”身份完成一个“曦源”项目，并须以项目调研报告为基础，继续以“队长/项目负责人”身份参加复旦大学“卓越杯”创新创业大赛、全国“中社杯”社会服务技能大赛、沪浙社会工作案例大赛以及复旦大学本科生学科竞赛工作管理办法适用竞赛表所列本学科相关赛事及其他本学院认定的高水平、有影响力的赛事。&nbsp; &nbsp; &nbsp;&nbsp;"},{"title":"课程设置与修读要求","text":"每学期选修学分不得超过32学分。"}]}