e,"postGraduateDegreeType":{"nameZh":"选修课","nameEn":null,"id":2,"code":"2","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-19T22:06:45.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"选修课"}}},{"code":"SOCI50003","name":"Chinese Demography and Social Policy","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"选修课","nameEn":null,"id":2,"code":"2","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-19T22:06:45.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"选修课"}}},{"code":"SOCI50005","name":"Chinese Culture and Religion","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"选修课","nameEn":null,"id":2,"code":"2","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-19T22:06:45.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"选修课"}}},{"code":"SOCI50006","name":"中国城市化与发展","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"选修课","nameEn":null,"id":2,"code":"2","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-19T22:06:45.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"选修课"}}}]},{"id":"-101","rawId":"-101","parent":null,"level":"1.1.1","title":"荣誉项目路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"荣誉项目课程设置和修读要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n    鼓励学生选择荣誉项目，获得“本科荣誉证书”后，经筛选核准可对接研究生学段的卓博学员。","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"35","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"在专业进阶路径或荣誉项目基础上，修读1个跨学科微专业（学程）15学分（可在研究生学段修读），具体要求见教务处网站学程实施方案。","reference":false,"referenceId":null,"courses":[]},{"id":"-105","rawId":"-105","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"21","rawId":"21","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"35","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求至少修读1个本专业进阶课程模块和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。\n        辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~22","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":19.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"19","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础理论与技能—分支社会学—创新型实践”渐次推进、相互衔接的社会学教学体系，在分析现实社会问题的过程中培养实践技能，激发批判性思维和科研潜力。\n2. 全周期的科研训练体系，在1、2年级专业知识传授为主。3年级通过2学期的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n3. 多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛、“京东”社会学知识竞赛、全国和上海社会学学会年会等）。","reference":false,"referenceId":null,"courses":[{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"8","name":"专业外语","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"1","name":"博士学位论文开题","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"2","name":"博士生资格考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"3","name":"博士论文中期考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"6","name":"博士学位论文预审","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI30032","name":"论文写作","credits":2.0,"required":false,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"SOCI30041","name":"实地调查实践","credits":3.0,"required":false,"term":"暑期","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"SOCI80002","name":"高级社会学习明纳I","credits":2.0,"required":true,"term":"秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"学位核心课","nameEn":null,"id":1,"code":"1","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-20T12:45:06.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"学位核心课"}}},{"code":"SOCI80003","name":"高级社会学习明纳II","credits":2.0,"required":true,"term":"春","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"学位核心课","nameEn":null,"id":1,"code":"1","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-20T12:45:06.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"学位核心课"}}},{"code":"SOCI30050","name":"社会调查实践","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"SOCI40003","name":"学年论文","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"SOCI40006","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":81,"completeModules":true,"fetchedAt":"2026-10-31T16:45:05Z","programNotes":[{"title":"学科专业简介","text":"复旦大学社会学学科为“985工程”、“211工程”、“双一流”重点建设学科，上海市高校重点学科,在2017年教育部第四轮学科评估中被评为A类学科。据QS世界大学排名，复旦大学社会学稳定位于世界大学前50位，在亚洲地区位居前10。本系在社会学理论与方法、社会结构转型与社会治理、社会计算与机器学习、用户研究与项目评估、婚姻家庭与文化传承、老龄社会与健康发展、网络与青少年价值观等领域里，取得了在海内外学界有影响的成果。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，通过对高级社会学理论、方法及专业课程的系统学习，以及严格规范的社会学研究的实践和训练，培养适应教学、科研以及社会发展需要的社会学专业的高级人才。在理论、方法和技术上，具备同国际学术界对话的坚实基础，具备独立开展学术研究尤其是经验研究的能力，同时也具备全球化和国际比较研究的视野。使所培养的学生具有全球视野、创新意识和独立思考能力，具备运用社会学理论和方法分析中国社会和世界不同区域的社会所面对的重大现实问题的能力；成为在海内外学界及政商各界有优秀声誉的引领性人才。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"\n\n\n\n1、&nbsp;专业进阶路径：155学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;本路径学生本博期间必须修满教学计划规定的155学分，包括通识教育课程42学分、专业培养课程64学分、专业进阶模块修读30学分（本专业研究生课程不少于14学分）、融合创新能力模块19学分的修读。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;其中，本科学段需要完成132学分（含实践学分不低于32学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程38学分、专业培养课程55学分、专业进阶模块修读30学分、融合创新能力模块9学分。本科学段部分课程可由本研融通课程替换。\n\n\n2、&nbsp;本科荣誉项目：164学分\n\n\n&nbsp;&nbsp;&nbsp; 荣誉项目课程设置和修读要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。&nbsp;&nbsp; 鼓励学生选择荣誉项目，获得“本科荣誉证书”后，经筛选核准可对接研究生学段的卓博学员。&nbsp;\n\n\n3、&nbsp;跨学科学发展路径：170学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;在专业进阶路径或荣誉项目基础上，修读1个跨学科微专业（学程）15学分（可在研究生学段修读），具体要求见教务处网站微专业（学程）实施方案。&nbsp;其中，本科学段需要完成132学分，包括通识教育课程38学分、专业培养课程55学分、专业进阶模块修读30学分、融合创新能力模块9学分，修读学分不足部分可在全校所有本科生课程中任意选修。\n\n\n其他：\n\n\n*：多元发展路径中，专业进阶课程模块均可以冲抵微专业（学程），专业培养和多元发展路径共享的课程只计算一次学分。\n\n\n**：留学生和港澳台侨学生的通识教育课程修读要求，以及留学生的水平测试要求，参见相应修读说明。\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n1. 4年级结束时，如达到学士学位要求者理授予法学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到社会学系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。\n\n\n2. 社会学+AI学士双学位项目，如达到社会学-人工智能双学士学位要求者授予法学-工学双学士学位。\n\n\n（二）研究生学位\n\n\n1、 达到博士学位要求者授予法学博士学位。\n\n\n（1）必须已修满学校规定的学分，所有修读课程成绩合格，其中研究生学位课程平均绩点不低于2.5。\n\n\n（2）社会学学博士学位发表论文要求：符合《复旦大学社会发展与公共政策学院对博士学位申请人学术成果要求的说明》的条件。\n\n\n2、研究生学段主动退出和博士生资格考核不合格退出本博融通计划的学生，需按照社会学硕士培养方案修读课程，如达到硕士学位要求者授予法学硕士学位。\n\n\n（1）必须已修满学校规定的学分，所有修读课程成绩合格，其中研究生学位课程平均绩点不低于 2.5。\n\n\n（2）完成本培养方案“必修环节设置”部分规定的各个必修环节，且各环节的评定等级为合格。\n\n\n（3）论文工作时间不少于1年（从论文开题时计算）\n\n\n（4）通过学位论文审阅和答辩。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n\n\n\n1.课程体系\n\n\n&nbsp;&nbsp;&nbsp; 课程体系分为研究方法、理论训练以及社会学研究议题培养三个部分，每个部分配合基础课程和荣誉课程，并以荣誉课程为基础建立本研融通的核心课程体系。研究方法中涉及到统计学的训练以及质性研究方法训练，并鼓励学生修读AI相关交叉课程，进一步拓展研究工具箱。从第4学期开始，每学期开设大量社会学分支课程，给予学生充分认识到社会学前沿研究的机会，以便学生找到自己的研究兴趣点并尝试进行科研实践。鼓励学生修读荣誉课程。\n\n\n2.科研训练体系\n\n\n&nbsp; 建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师／拔尖导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。从2年级开始开设大量的社会学分支领域课程，鼓励学生接触前沿研究并选择自己的研究兴趣点。3年级开始包括实地调研在内的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n\n\n"},{"title":"课程设置与修读要求","text":"每学期选修学分不得超过32学分。"}]}