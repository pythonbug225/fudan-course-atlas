":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~25","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":7.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"7","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"1061","name":"前沿讲座","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"101","name":"无学分讨论班","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"STAT30006","name":"科研实践","credits":3.0,"required":true,"term":"3,4,5,6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"STAT40004","name":"生产实习","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"STAT40003","name":"毕业论文","credits":3.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":80,"completeModules":true,"fetchedAt":"2026-10-31T16:43:45Z","programNotes":[{"title":"学科专业简介","text":"复旦大学大数据学院于 2015 年 10 月 8 日成立，这是百年复旦在建设世界一流大学和一流学科征程中，瞄准国际科技前沿、聚焦国家创新发展、激发学科动能的重大战略举措。学院致力于大数据相关的科学研究、人才培养和产业创新，以计算机科学、统计学、计算数学为三大基础支撑性学科，与信息科学、生命科学、医学、经济学、社会学、管理学、环境学、工学等学科领域进行深度的交叉科学研究和成果推广应用。学院探索全新的学生培养模式，起步早、布局优，着力打造扎实的数据科学研究和应用的各类平台，十年来，为社会培养了一批基础扎实、眼界宽阔的数据科学人才。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2 是通识和专业教育，X 是多元发展路径，Y 为融合创新能力）为途径，以计算机科学、统计学、计算数学为三大基础支撑性学科，与信息科学、生命科学、医学、经济学、社会学、管理学、环境学、工学等学科领域进行深度的交叉科学研究和成果推广应用，培养德智体美劳全面发展的数据科学领军人才。学生应具有良好的思想道德素质和科学的世界观，具有人文情怀，具备扎实的数据科学基础知识、突出的科学素养与创新思维、交叉学科的学术能力、开阔的国际视野和跨文化环境下的交流与合作能力，能够服务国家重大战略需求。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"1.修业年限：4 年（类型：■本科、□本硕、□本博）2.学位授予说明：\n\n\n\n\n授予学位\n\n\n专业名称\n\n\n学位类型\n\n\n学段审核要求\n\n\n\n\n理学学士\n\n\n数据科学与大数据技术\n\n\n/\n\n\n□ 按照不少于总学分比例____%\n\n\n\n\n■ 按照不少于学分数 139\n\n\n\n\n■ 必修课组须通过\n\n\n通识教育课程 40 学分\n\n\n\n\n专业培养课程 68 学分\n\n\n\n\n专业进阶模块 24 学分\n\n\n\n\n融合创新能力模块 7 学分\n\n\n\n\n□其他____________________\n\n\n\n\n&nbsp;"},{"title":"学分要求","text":"\n1. 专业进阶路径：139 学分\n本路径学生需要完成 139 学分（含实践学分不低于 36.5 学分；含美育学分不少于 2 学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读 1 学分，并至少参与一项艺术实践活动；劳动教育不少于 32 学时，并满足劳动周教育要求），包括通识教育课程 40 学分、专业培养课程 68 学分、专业进阶模块修读 24 学分、融合创新能力模块 7 学分。\n2. 本科荣誉项目：144 学分\n在专业进阶路径基础上，修读荣誉课程不少于 5 门课。荣誉项目课程设置和修读要求请见数据科学与大数据技术“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。\n3. 跨学科发展路径：139 学分\n本路径学生需要完成 139 学分，包括通识教育课程 40 学分、专业培养课程 68 学分、融合创新能力模块 7 学分、修读 1 个跨学科微专业（学程）24 学分。"},{"title":"学位要求","text":"四年级结束时，如达到学士学位要求者授予理学学士学位。（1）修满规定的学分，达到本科教学培养方案规定的各项要求。（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于 2.0 。（3）在此基础上，达到数据科学与大数据技术“荣誉证书”获得条件的授予“荣誉证书”，具体要求请见数据科学与大数据技术“荣誉项目”实施方案。"},{"title":"课程体系与科研训练体系","text":""}]}