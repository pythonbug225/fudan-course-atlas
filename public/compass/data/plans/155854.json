:false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"45","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满30学分。修读1个跨学科微专业（学程）15学分。修读学分不足部分可在全校所有本科生课程中任意选修。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"45","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满45学分。修读1个创新创业学院开设的创新创业学程15学分。修读学分不足部分可在全校所有本科生课程中任意选修。创新创业学程课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求至少修读1个本专业进阶课程模块和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。\n        辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~21","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":9.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"9","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础理论与技能—分支社会学—创新型实践”渐次推进、相互衔接的社会学教学体系，在分析现实社会问题的过程中培养实践技能，激发批判性思维和科研潜力。\n2. 全周期的科研训练体系，在1、2年级专业知识传授为主。3年级通过2学期的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n3. 多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛、“京东”社会学知识竞赛、全国和上海社会学学会年会等）。","reference":false,"referenceId":null,"courses":[{"code":"SOCI30032","name":"论文写作","credits":2.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI30041","name":"实地调查实践","credits":3.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI60004","name":"社会学习明纳I","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI60005","name":"社会学习明纳II","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI30050","name":"社会调查实践","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI40003","name":"学年论文","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"SOCI40006","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":104,"completeModules":true,"fetchedAt":"2026-10-31T16:45:04Z","programNotes":[{"title":"学科专业简介","text":"复旦大学社会学学科为“985工程”、“211工程”、“双一流”重点建设学科，上海市高校重点学科,在2017年教育部第四轮学科评估中被评为A类学科。据QS世界大学排名，复旦大学社会学稳定位于世界大学前50位，在亚洲地区位居前10。本系在社会学理论与方法、社会结构转型与社会治理、社会计算与机器学习、用户研究与项目评估、婚姻家庭与文化传承、老龄社会与健康发展、网络与青少年价值观等领域里，取得了在海内外学界有影响的成果。"},{"title":"培养目标","text":"&nbsp; &nbsp; 按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，致力于培养德智体美劳全面发展，具有广博的社会学理论知识、扎实的社会调查研究技能，能在教学科研机构、党政机关、企事业单位、社会团体从事社会调查研究、发展规划、政策研究、传媒与市场研究、公共管理等工作的社会学高级专门人才。&nbsp; &nbsp; 要求学生掌握社会学的基本理论，熟悉社会学的主要学派及其观点；掌握社会调查研究的基本方法、社会统计分析的基本技术；初步具备综合运用社会学的理论与方法对社会现象、社会过程进行科学研究的能力；具备将社会学的基本理论与方法付诸实际应用和分析现实问题的能力。熟练掌握一门外语，具有较强的语言、写作、人际沟通以及组织管理能力。"},{"title":"培养理念","text":"&nbsp; &nbsp; 秉持亦知亦行、全球视野与本土经验相结合的培养理念，注重使学生具备社会学理论、社会研究方法的扎实基础和跨文化的知识视野，强化人工智能等相关技能的训练；使学生勇于站在世界文明的高度，追求社会学的学术创新，运用社会学的理论、方法比较、分析、解决中国和世界不同区域社会的现实问题。"},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：R本科、□本硕、□本博）+B14:L24\n&nbsp;\n&nbsp;\n\n\n2. 学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n法学学士\n/\n社会学\n□按照不少于总学分比例____%\n\n\nR按照不少于学分数 118 &nbsp;\n\n\nR必修课组须通过\n通识教育课程24学分\n\n\n专业培养课程55学分\n\n\n专业进阶模块30学分\n\n\n融合创新能力模块9学分\n\n\n□其他____________________\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 本专业学生毕业时须满足通识教育课程（含通识教育核心课程和专项教育课程）24学分、专业培养课程55学分、融合创新能力模块9学分和多元发展路径课程的修读要求，总学分不低于118学分，达到学位要求者授予法学学士学位。\n\n\n"},{"title":"学分要求","text":"\n\n\n1、 专业进阶路径：118学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;本路径学生需要完成118学分，包括通识教育课程24学分、专业培养课程55学分、专业进阶模块修读30学分、融合创新能力模块9学分。\n\n\n2、 本科荣誉项目：125学分\n\n\n&nbsp;&nbsp;&nbsp; 荣誉项目课程设置和修读要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n\n\n3、 跨学科学发展路径：133学分\n\n\n&nbsp;&nbsp; 本路径学生需要完成135学分，包括通识教育课程24学分、专业培养课程55学分、专业进阶模块30学分、融合创新能力模块9学分、修读1个跨学科微专业（学程）15学分。修读学分不足部分可在全校所有本科生课程中任意选修。\n\n\n4.创新创业路径：133学分\n\n\n&nbsp;本路径学生需要完成133学分，包括通识教育课程24学分、专业培养课程55学分、专业进阶模块30学分、融合创新能力模块9学分, 以及1个创新创业学院开设的创新创业学程。修读学分不足部分可在全校所有本科生课程中任意选修。创新创业学程课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n\n\n5、社会学+AI双学士学位项目\n\n\n&nbsp; &nbsp; 具体要求见社会学-人工智能双学士学位项目培养方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n\n\n6、辅修学士学位路径\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;要求至少修读1个本专业进阶课程模块和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。\n\n\n其他：\n\n\n*：多元发展路径中，专业进阶课程模块均可以冲抵学程，专业培养和多元发展路径共享的课程只计算一次学分。\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n1. 4年级结束时，如达到学士学位要求者理授予法学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到社会学系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见社会发展与公共政策学院本科“荣誉项目”实施方案。\n\n\n2. 社会学+AI学士双学位项目，如达到社会学-人工智能双学士学位要求者授予法学-工学双学士学位。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n\n\n\n1.课程体系\n\n\n&nbsp;&nbsp;&nbsp; 课程体系分为研究方法、理论训练以及社会学研究议题培养三个部分，每个部分配合基础课程和荣誉课程，并以荣誉课程为基础建立本研融通的核心课程体系。研究方法中涉及到统计学的训练以及质性研究方法训练，并鼓励学生修读AI相关交叉课程，进一步拓展研究工具箱。从第4学期开始，每学期开设大量社会学分支课程，给予学生充分认识到社会学前沿研究的机会，以便学生找到自己的研究兴趣点并尝试进行科研实践。鼓励学生修读荣誉课程。\n\n\n2.科研训练体系\n\n\n&nbsp; 建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师／拔尖导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。从2年级开始开设大量的社会学分支领域课程，鼓励学生接触前沿研究并选择自己的研究兴趣点。3年级开始包括实地调研在内的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n\n\n"},{"title":"课程设置与修读要求","text":"每学期选修学分不得超过32学分。"}]}