Id":"-101","parent":null,"level":"1.1.1","title":"荣誉项目路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"26","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满26学分。要求修读1个非本专业独立开设的微专业（学程）。微专业（学程）课程详见教务处学程项目网页。学分不足部分可在全校所有本科生课程中任意选修。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"26","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满26学分。要求修读1个创新创业学院开设的创新创业微专业（学程）。创新创业微专业（学程）课程详见教务处学程项目网页。学分不足部分可在全校所有本科生课程中任意选修。","reference":false,"referenceId":null,"courses":[]},{"id":"21","rawId":"21","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"48","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求在本专业的专业进阶课程模块修读8学分和1个辅修学士学位项目40学分，辅修学士学位应与主修学士学位归属不同的本科专业大类。辅修学士学位项目课程设置详见教务处辅修学士学位项目网页。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"多元发展路径中，辅修学士学位项目或每16学分专业进阶课程均可以冲抵微专业（学程），专业培养和多元发展路径共享的课程只计算一次学分。","reference":false,"referenceId":null,"courses":[]},{"id":"2~18","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":11.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"11","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础型—综合型—创新型”渐次推进、相互衔接的融合创新能力教学体系，在解决复杂问题的过程中培养批判性思维和学术潜力。\n2. 全周期的学术训练体系，从一年级的专业汉语、二三年级的社会实践报告、四年级的毕业论文，为本科留学生构建完整的学术规范训练，培养在跨文化环境中发现真实问题、科学分析问题、创新解决问题的思维体系，激发融合多元文化的创新志趣。\n3. 多渠道支持本科留学生参加国内国际文化交流和学术交流，鼓励学生参加国内国际各类创新竞赛。","reference":false,"referenceId":null,"courses":[{"code":"GECS10003","name":"留学生专业汉语I","credits":4.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"GECS10004","name":"留学生专业汉语II","credits":4.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"GEIN30001","name":"留学生创新与创业","credits":1.0,"required":true,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ICLE40012","name":"社会实践（报告）","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ICLE40013","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":138,"completeModules":true,"fetchedAt":"2026-10-31T16:44:14Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; 1993年，经国家教委批准，国际文化交流学院开设了专门面向外国留学生的本科专业“中国语言文化专业”（现为汉语言[对外]专业），含对外语言文化方向和对外商务汉语方向。学院作为培养国际学生汉语水平与文化理解的重要基地，始终秉持“育人为本，质量为先”的教育理念，致力于为学生提供优质的教育资源和全面的发展平台。"},{"title":"培养目标","text":"&nbsp; &nbsp; 按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的汉语文化专门人才。学生应具有良好的思想道德素养和人文情怀，具备突出的科学素养与创新思维，具有开阔的国际视野和跨文化环境下的交流与合作能力。"},{"title":"基本要求","text":""},{"title":"修业要求","text":""},{"title":"学分要求","text":""},{"title":"学位要求","text":"\n\n\n本科学位\n\n\n1.&nbsp;四年级结束时，如达到学士学位要求者授予文学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）有HSK六级和HSK口语（高级）证书，且HSK口语（高级）成绩和HSK六级听力、阅读、写作三个单科成绩均大于或等于60分。HSK六级和HSK口语（高级）证书须在两年有效期内。\n\n\n（3）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n2.&nbsp;完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生，在获得文学学士学位的同时，可获得相应的辅修学士学位证书。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系\n&nbsp; &nbsp; 以学科领域为横、课程内容梯度为纵，建立了难度逐级提升的专业核心课程和专业进阶课程体系，为本科留学生打下扎实的中国语言和文化基础，能够修读更高阶的理论课程。\n2.科研训练体系\n&nbsp; &nbsp; 建立了科学合理的逐级递进的训练体系，给低年级本科留学生配备学业导师，引导和培育学生的学术兴趣。二年级开始通过持续的社会实践与学术读写训练的融合，激发本科留学生对中国语言文化、中国社会的深度探索和多元文化融合创新志趣。\n&nbsp;"},{"title":"课程设置与修读要求","text":"\n\n\n备注\n每学期选修学分不得超过32学分。\n\n\n\n&nbsp;"}]}