0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"15","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满15学分。要求在1个非本专业独立开设的微专业（学程）15学分。学程课程详见教务处微专业项目网页。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"15","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满15学分。要求修读1个创新创业学院开设的创新创业微专业（学程）。创新创业学程课程详见教务处微专业项目网页。","reference":false,"referenceId":null,"courses":[]},{"id":"21","rawId":"21","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"40","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求修读本专业的专业进阶课程模块修读15学分和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。辅修学士学位项目课程设置详见教务处辅修学士学位项目网页。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~35","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":20.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"20","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础型—综合型—创新型”渐次推进、相互衔接的基础物理与核技术实验教学体系，在解决复杂问题的过程中培养实验技能，激发批判性思维和研发潜力。\n2. 全周期的科研训练体系，在1、2年级设立核科学与技术前沿讲座课和无学分讨论班，引导学生早进课题组轮转，培育兴趣。3年级通过2学期的科研实践训练，建议完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n3. 多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛、全国大学生物理实验竞赛、中国大学生物理学术竞赛等）。","reference":false,"referenceId":null,"courses":[{"code":"PHYS10009","name":"大学物理实验Ⅰ","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"101","name":"无学分讨论班","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHYS20015","name":"大学物理实验Ⅱ","credits":2.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS10001","name":"核科学与技术前沿导论","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS20016","name":"大学物理实验Ⅲ","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS30004","name":"科研实践Ⅰ","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"NST40004","name":"核技术综合实验","credits":3.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHYS30006","name":"科研实践Ⅱ","credits":3.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"NST20002","name":"专业实践","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS30007","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":79,"completeModules":true,"fetchedAt":"2026-10-31T16:44:16Z","programNotes":[{"title":"学科专业简介","text":"复旦大学核科学与技术系前身为1958年成立的复旦大学原子能系（1977年改称为原子核科学系），又称物理二系。设有核科学与核技术国家一流学科，下设核工程、核聚变、核技术等学科方向。核科学与技术系秉承求实创新、追求卓越的发展理念，以先进的育人理念、雄厚的师资力量、和谐的管理氛围、优质的学术成果等优势为国家核科学与核技术领域培养专门高端人才。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的核科学与核技术方向领军人才。学生具有良好的思想道德素质和科学的世界观，具有人文情怀，深厚的科学素养、卓越的创新意识、开阔的国际视野。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"1.修业年限：4年（类型：√本科、□本硕、□本博）\n2. 学位授予说明：\n\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n工学学士\n/\n核工程与核技术\n□按照不少于总学分比例____%\n\n\n√按照不少于学分数 142\n\n\n√必修课组须通过\n通识教育课程39学分\n\n\n专业培养课程68学分\n\n\n专业进阶模块15学分\n\n\n融合创新能力培养20学分\n\n\n□其他____________________\n\n\n"},{"title":"学分要求","text":"\n1.专业进阶路径：142学分\n本路径学生需要完成142学分（含实践学分不低于35.5学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程68学分、专业进阶模块修读15学分、融合创新能力模块20学分。\n2. 本科荣誉项目：147学分\n在专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见核科学与技术系“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。\n3.跨学科学发展路径：142学分\n本路径学生需要完成142学分，包括通识教育课程39学分、专业培养课程68学分、融合创新能力模块20学分、修读1个跨学科微专业（学程）15学分。\n4.核工程与核技术+国际政治双学士学位项目：174分\n在专业进阶路径或荣誉项目基础上，修读国际政治专业项目课程38学分。具体要求见核工程与核技术-国际政治（全球领导力）双学士学位项目培养方案"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予工学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。&nbsp;\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到核科学与技术系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见核科学与技术系“本科荣誉项目”实施方案。\n2. 核工程与核技术+国际政治（全球领导力）学士双学位项目，如达到核工程与核技术-国际政治（全球领导力）双学士学位要求者授予工学-法学双学士学位。"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n以高难度、大学分的荣誉课程为基础建立专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的专业进阶课程体系。为鼓励学生挑战自我，5门普通物理课程设置免修制度，免修考试通过后可直接修读后续高阶理论课程，5门高阶理论课程每学期都开设，可随时修读。\n2.科研训练体系&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师／科创导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在1、2年级设立核科学与技术前沿导论课和无学分讨论班，引导学生早进课题组轮转，培育兴趣。3年级通过2学期的科研实践训练，建议完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。"}]}