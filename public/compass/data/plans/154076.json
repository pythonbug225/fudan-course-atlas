alse,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~26","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":10.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"10","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"ECON10001","name":"走进经济学系列讲座","credits":0.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON20002","name":"中国经济学系列讲座","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON10002","name":"数据分析方法应用初步","credits":3.0,"required":true,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECON30002","name":"科研实践（复芏计划）","credits":2.0,"required":false,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30003","name":"创新实践","credits":2.0,"required":false,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30005","name":"学术实践","credits":1.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30004","name":"社会实践","credits":1.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON20010","name":"“经行天下”本科生专项社会实践","credits":1.0,"required":false,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECON40003","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":80,"completeModules":true,"fetchedAt":"2026-10-31T16:44:46Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp;复旦大学国际经济与贸易-数据科学与大数据技术双学士学位项目依托学科基础雄厚的经济学院世界经济学科和大数据学院，适应大数据人工智能全面应用时代经济形态数字化、经济分析方法智能化的新形势，特别是在经济全球化和开放经济的现实语境下，大数据人工智能与国际金融、国际贸易、国际投资、国际财务管理等经济学领域出现深度融合的新形势，致力于培养既具备扎实国际经济学理论知识与世界经济视野，又深刻理解和掌握大数据理论与技术的复合型高端人才。经济学院世界经济学科是国家重点学科，拥有我国第一个世界经济系和教育部人文社科重点科研基地—世界经济研究所。世界经济系培养了众多学术大家与各界精英人才，专业领域影响深厚，科研力量雄厚。大数据学院瞄准国际科技前沿、聚焦国家创新发展，探索全新的学生培养模式，着力打造扎实的数据科学研究和应用的各类平台。"},{"title":"培养目标","text":"&nbsp; &nbsp; &nbsp; 本项目培养德智体美劳全面发展，掌握马克思主义经济学基本原理和国际经济学基本理论，掌握数据科学技术，具备扎实国际经济学理论知识与世界经济视野，具有社会责任感、全球视野和国际竞争力的经济金融与新兴科技相结合的复合型高端人才。本项目要求学生掌握马克思主义经济学和国际经济学基本分析方法；熟练掌握中国和世界主要国家地区的经济政策和法规；掌握数据科学所需的计算机技术基础；注重大数据与人工智能在现代经济学研究中的运用技能和基本分析方法训练；具备运用数据科学方法分析开放经济领域问题的能力。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：本科）\n&nbsp;\n&nbsp;\n\n\n2. 学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n经济学学士-理学学士双学位\n/\n国际经济与贸易-数据科学与大数据技术双学士学位\n□按照不少于总学分比例____%\n\n\n√按照不少于学分数 175\n\n\n√必修课组须通过\n通识教育课程36学分\n\n\n专业培养课程103学分\n\n\n专业进阶模块26学分&nbsp;\n\n\n融合创新能力模块10学分\n\n\n□其他____________________\n\n\n"},{"title":"学分要求","text":"\n\n\n\n1、 专业进阶路径：175学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 本路径学生需要完成175学分（含实践学分不低于32学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程103学分、专业进阶模块修读26学分、融合创新能力模块10学分。\n\n\n2、 本科荣誉项目：175学分\n\n\n&nbsp;&nbsp; 在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见经济学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养—常用文档。鼓励学生选择荣誉项目。&nbsp;\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n4年级结束时，如达到学士学位要求者授予国际经济与贸易-数据科学与大数据技术专业毕业证书及经济学学士-理学学士双学位证书。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n（3）在此基础上，达到经济学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见经济学院“本科荣誉项目”实施方案。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n\n\n\n1.课程体系\n\n\n&nbsp;&nbsp;&nbsp; 系统整合国际经济与贸易学科的理论范式与数据科学领域的技术前沿，基于双专业的核心课程、深度融合课程、创新实践课程形成交叉融合人才培养的协同体系，培养具有世界经济视野、数智化决策素养和跨学科创新思维范式的高端人才。以14门高难度、大学分的荣誉课程为基础建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。鼓励学生修读荣誉课程。\n\n\n2.科研训练体系\n\n\n&nbsp; 建立螺旋递进的全周期科研训练体系，给低年级本科生配备双专业的导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在1、2年级设立讲座课、学术创新和学术实践课，引导学生早进课题组轮转，培育兴趣。\n\n\n"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}