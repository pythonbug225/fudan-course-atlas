d":null,"courses":[]},{"id":"-101","rawId":"-101","parent":null,"level":"1.1.1","title":"荣誉项目路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"在专业进阶路径基础上，修读荣誉课程不少于6门课，且达到荣誉项目修读要求。荣誉项目课程设置和修读要求请见数学科学学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"30","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满30学分。要求修读2个非本专业独立开设的微专业（学程），可选择学科微专业（学程）或跨学科微专业（学程）。学分不足部分可在全校所有本科生课程中任意选修。微专业课程详见教务处微专业项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"30","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满30学分。要求修读1个创新创业学院开设的创新创业微专业（学程），以及1个非本专业独立开设的微专业（学程）。学分不足部分可在全校所有本科生课程中任意选修。创新创业微专业课程详见教务处微专业项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"多元发展路径中，在专业进阶模块中修满12学分可以冲抵1个微专业（学程），专业培养和多元发展路径共享的课程只计算一次学分。","reference":false,"referenceId":null,"courses":[]},{"id":"2~26","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":4.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"4","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"101","name":"无学分讨论班","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MATH40001","name":"学术前沿专题Ⅰ","credits":1.0,"required":false,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MATH40002","name":"学术前沿专题Ⅱ","credits":1.0,"required":false,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MATH50001","name":"独立学习","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MATH40033","name":"毕业论文(含专题讨论)","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MATH50002","name":"科研实践","credits":3.0,"required":false,"term":"6,7,8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":157,"completeModules":true,"fetchedAt":"2026-10-31T16:45:19Z","programNotes":[{"title":"学科专业简介","text":"复旦数学在国际上有重要影响，在国内有显著地位，先后入选国家一级重点学科、国家“双一流”建设学科、上海市高峰学科，前三次全国一级学科整体水平评估中均名列全国前2，近两次获评A+。面向国际科技前沿、面向国家重大需求开展研究，在代数几何与代数拓扑、偏微分方程与动力系统、泛函分析与算子理论等基础数学前沿领域取得国际领先成果，在人工智能理论与算法、数学物理反问题与控制、数据建模与科学计算等应用数学核心方向取得重要突破。已发展成为一个在国际上有重要影响的数学人才培养中心、科学研究中心和学术交流中心。"},{"title":"培养目标","text":"培养具备扎实且系统的数理基础，精通应用于AI的数学理论与方法，并拥有跨学科知识体系和系统思维能力的人才。能够融汇数学理论，深入分析并设计高效的AI算法，实现对AI技术的创新和改进；在包括数学科学在内的各个领域中，解决复杂的AI理论问题，并具备进一步发展AI技术方法的能力。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"修业年限：4年"},{"title":"学分要求","text":"本专业学生毕业时须满足通识教育课程（含通识教育核心课程和专项教育课程）36学分、专业培养课程108学分、融合创新能力培养4学分和多元发展路径课程的修读要求，总学分不低于154学分（含实践学分不低于39学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），达到学位要求者授予理学学士和工学学士学位。\n&nbsp;"},{"title":"学位要求","text":"4年级结束时，如达到学士学位要求者授予理学和工学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到数学科学学院“荣誉证书”获得条件的授予“荣誉证书”，具体要求请见数学科学学院“荣誉项目”实施方案。\n&nbsp;"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系\n以17门高难度、大学分的荣誉课程为基础建立的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的专业进阶课程体系。\n备注：课程代码数字部分的第一位代表了课程难度等级。每学期选修学分不得超过32学分。\n2.科研训练体系\n本科阶段设立学术前沿专题课程、独立学习课程和无学分讨论班，引导学生早进课题组轮转，通过“复芏计划”激发创新志趣。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内外高水平学科创新竞赛。"}]}