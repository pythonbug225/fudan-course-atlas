d":null,"courses":[{"code":"52","name":"科研实践I","credits":3.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"53","name":"科研实践II","credits":3.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"101","name":"无学分讨论班","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"8","name":"专业外语","credits":1.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"1","name":"博士学位论文开题","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"2","name":"博士生资格考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"3","name":"博士论文中期考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"6","name":"博士学位论文预审","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"EST40012","name":"模拟与数字电路实验","credits":3.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"EST40035","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"MATH10025","name":"相辉前沿专题","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ICE40005","name":"信号与系统实验","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BME50025","name":"生物医学工程专业实验","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BME30004","name":"医学电子创新设计与实验","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ICE50010","name":"前沿讲座","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":87,"completeModules":true,"fetchedAt":"2026-10-31T16:45:15Z","programNotes":[{"title":"学科专业简介","text":"复旦大学生物医学工程研究始于1972年，是国内起步最早的单位之一，1996年获准成立生物医学工程硕士点，2000年获准成立生物医学工程一级学科博士授予点，2003年获批建立生物医学工程博士后流动站，建立起从本科到硕士点、博士点、博士后流动站的完整人才培养体系。生物医学工程学科是上海市重点学科、上海市高校一流学科(B类)，也是复旦双一流建设学科“生物医学工程与精准医疗技术”、复旦大学集成芯片与系统全国重点实验室的重要组成部分。主要研究方向包括医学影像与人工智能、生物医学传感技术与芯片、生物医学数据学等。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养适应未来需要的、具有“国家意识、人文情怀、科学精神、专业素养、国际视野”的全面发展的生物医学工程专业领军人才，能够在未来的关键领域从事科研教学、技术开发和管理等工作。培养学生优秀的思想道德素质和完善的世界观、优秀的科学素养和创新精神、开阔的国际视野和充分的交流合作能力，为未来世界的发展和国家的重大战略需求做好充分的准备。博士毕业时，具有独立从事科学研究的能力和严谨求实的科学态度和作风，在一个或几个国际前沿方向中有较深入的研究，并取得创造性的成果。"},{"title":"基本要求","text":""},{"title":"学分要求","text":""},{"title":"学位要求","text":"（一）本科学位\n1. 在4年级结束时，如达到学士学位要求者授予工学学士学位。 &nbsp;（1）修满规定的学分，达到本科教学培养方案规定的各项要求。（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。（3）在此基础上，达到“本科荣誉证书”获得条件的授予“本科荣誉证书”。具体要求见“生物医学工程与技术创新学院本科荣誉项目实施方案”。\n2. 本科学段主动退出或转段考核不合格退出本博融通计划的学生，按照生物医学工程专业本科培养方案修读课程，达到学士学位要求者授予工学学士学位。\n（二）研究生学位\n1. 申请博士学位时，必须已修满规定的学分，所有修读课程成绩合格，其中研究生学位课程平均绩点不低于2.5。学位审核各环节按《复旦大学学位授予工作细则》执行。学术成果需达到学院学位评定分委员会要求，具体参照《复旦大学博士学位基本要求》及院系相关文件规定执行。学位申请需通过校学位评定委员会审议，达到博士学位要求者授予工学博士学位。\n2. 研究生学段主动退出或博士生资格考核不合格退出本博融通计划的学生，按照生物医学工程本硕融通培养方案修读课程，达到硕士学位要求者授予工学硕士学位。"},{"title":"课程体系与科研训练体系","text":""}]}