":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求修读本专业的专业进阶课程模块修读15学分和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。辅修学士学位项目课程设置详见教务处辅修学士学位项目网页。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~25","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":7.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"7","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"1021","name":"其他本科生学术研究计划","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"53","name":"科研实践II","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"55","name":"科研实践III","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"52","name":"科研实践I","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"107","name":"其他","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"TMAX70002","name":"专业实习（挂职锻炼）","credits":3.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"TMAX40005","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":87,"completeModules":true,"fetchedAt":"2026-10-31T16:45:03Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; 复旦大学在马克思主义理论的宣传、研究、教学等方面有着光荣的传统。复旦大学马克思主义学院是全国首批重点马克思主义学院，马克思主义理论学科入选国家“双一流”建设学科、上海高校一流学科和高峰学科，在全国第五轮学科评估中荣获最高等级。经过多年发展，复旦大学马克思主义理论学科形成了有众多相关人文社科重点学科融合涵养的、有多个学术与实践平台支撑的学科，在培养高层次马克思主义理论人才方面，积累了丰厚的历史经验，树立了一流的学术品牌。&nbsp; &nbsp; 复旦大学人工智能专业培养体系充分体现了深基础、强交叉的复旦特色， 专业课由计算机科学技术学院、大数据学院、类脑研究院、数学学院等机构的高水平师资开设。承担国家重大专项、重点研发计划、973 计划、863 计划、国家自然科学基金重点项目及上海市重大科技攻关计划等大量科研项目，在高质量学术论文数量方面成果突出。"},{"title":"培养目标","text":"&nbsp; &nbsp; 本项目致力于培养政治立场坚定，理论素养雄厚，德智体美劳全面发展，具有较强社会实践能力、学术创新能力，兼具人工智能跨学科背景的马克思主义理论专业人才；对标教育强国建设的新形势新任务新要求，培养学生系统掌握马克思主义基本理论，熟悉社会科学基本研究方法，能够有效运用人工智能的实践开展“马克思主义理论+人工智能”跨学科交叉融合研究及相关领域的实务工作。"},{"title":"基本要求","text":"&nbsp; &nbsp;（1）具有良好的马克思主义理论功底和相关专业知识，掌握马克思主义学科前沿动态；&nbsp; &nbsp;（2）能够独立运用掌握的理论知识和分析工具开展高水平研究工作，发表高水平研究成果；&nbsp; &nbsp;（3）具有较强的学术创新能力，并取得一定学术创新成果；&nbsp; &nbsp;（4）熟练掌握一门外语并能够进行学术交流和学术写作；&nbsp; &nbsp;（5）掌握人工智能基础理论，能够有效运用人工智能实践开展“马克思主义理论+人工智能”跨学科交叉融合研究；&nbsp; &nbsp;（6）具备参与组织协调学术团队开展高水平专题研究的能力；&nbsp; &nbsp;（7）达到相关课程学习要求、学位论文标准和科研论文发表要求。"},{"title":"修业要求","text":"修业年限：4年（类型：本科） 总学分177分"},{"title":"学分要求","text":"&nbsp; &nbsp; &nbsp; 专业进阶路径学生需要完成177学分（含实践学分不低于44学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程24学分、专业培养课程122学分、专业进阶模块修读24学分）、融合创新能力模块7学分。"},{"title":"课程体系与科研训练体系","text":"\n\n\n1.课程体系\n\n\n通识课程、专业核心课、专业进阶课、跨学科课程及融合创新培养课程组成\n\n\n2.科研训练体系\n\n\n“望道”大学生读经典品牌项目、“治国理政”全国大学生学术论坛、本科生学术资助项目、学术写作训练、公文写作训练、毕业论文或设计等\n\n\n"},{"title":"课程设置与修读要求","text":"备注：每学期修读学分不得超过32学分。"}]}