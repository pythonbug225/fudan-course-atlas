se,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"30","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"30 credits are required. One independent course package offered by another major and one-course package in innovation and entrepreneurship offered by the Innovation and Entrepreneurship Institute are required, with any shortfall in credits to be taken from all undergraduate programs. \nFor the courses of the innovation and entrepreneurship programs, please refer to the academic website https://jwc.fudan.edu.cn/.","reference":false,"referenceId":null,"courses":[]},{"id":"21","rawId":"21","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"35","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"A minimum of 15 credits from M1 in GBF and a minor in a bachelor degree program offered by an external school are required. A corresponding minor bachelor's degree certificate is awarded to those who meet the requirements of the program and the university's graduation and degree award requirements. \nFor details on the curriculum of the Minor degree, please refer to the academic website https://jwc.fudan.edu.cn/.","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsR