Course":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40098","name":"患者安全","credits":1.0,"required":false,"term":"春","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHPM40017","name":"环境卫生学","credits":2.5,"required":false,"term":"春","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHPM40019","name":"营养与食品卫生学","credits":2.5,"required":false,"term":"春","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40012","name":"医学文献检索与利用A","credits":2.5,"required":false,"term":"春","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHPM30013","name":"卫生统计学C","credits":2.0,"required":false,"term":"春","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":48.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"48","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1.模块化的法医学实验教学改革，培养学生自主探究与批判思维能力。为增强本科生的实践能力与案例分析能力，学院对实验教学体系进行全面优化，由“统一规定流程”向“模块化自主选择”转变，突出学生的自主学习和个性化发展。优化后的课程体系分为“法医学核心实验”与“法医学综合实验”两大类：核心实验为必修课程，聚焦法医病理学、法医物证学、临床法医学及法医毒物学等核心技能训练；综合实验设置5至6个模块，如DNA鉴定、法医影像、毒物检测、伤情鉴定等，学生可自主选择其中三个深入学习，并完成案例化实践。\n2. 全周期的法医学科研与实践训练体系。在低年级设置法医学相关课程，引导学生认识法医学最新研究进展与司法应用，培养创新意识和批判性思维能力。通过实验室轮转制度，鼓励学生尽早进入法医学实验室、司法鉴定中心或合作公安技术部门参与科研与案例分析，逐步形成稳定的研究兴趣和专业方向。实验室选择灵活多元，既可在学院实验室开展研究，也可进入复旦大学其他院系或合作司法鉴定机构进行跨学科学习与合作。\n3. 多渠道支持学生参加国内外高水平学术与实践交流。鼓励学生参与国内外法医学学术会议（如全国法医学学术大会、国际法医学大会）和跨领域研讨会，开阔国际视野；支持学生参加高水平创新与技能竞赛，提升案例分析、技术应用及跨学科协作能力，推动理论知识与司法实践的深度融合。","reference":false,"referenceId":null,"courses":[{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED30103","name":"功能学科综合实验","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40035","name":"毕业论文","credits":6.0,"required":true,"term":"10","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40032","name":"内科实习","credits":8.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40033","name":"外科实习","credits":8.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40062","name":"儿科实习","credits":4.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40063","name":"妇产科实习","credits":4.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MED40034","name":"专业实习","credits":16.0,"required":true,"term":"9","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":64,"completeModules":true,"fetchedAt":"2026-10-31T16:43:50Z","programNotes":[{"title":"学科专业简介","text":"复旦大学法医学与法庭科学学院底蕴深厚，其前身可追溯至1953年上海第一医学院病理学系设立的法医教学组。1984年，学校成立法医学教研室（系）并迎来首届法医学专业本科生，是国内最早开设该专业的高校之一。四十余年来，学校始终坚持高标准的教学质量、前沿的科研探索与深度的社会服务，构建起涵盖博士、硕士、本科的完整人才培养体系，并获批国家一流法医学本科专业建设单位。2025年5月，为进一步强化人才输送能力、服务全面依法治国战略，学校在原法医学系基础上，整合法庭科学研究院等多方优势力量，正式成立法医学与法庭科学学院。学院依托复旦大学深厚的学术积淀与多学科交叉优势，致力于培养兼具家国情怀、社会责任、国际视野、创新精神与协作能力的复合型、应用型拔尖人才。"},{"title":"培养目标","text":"本专业主要培养具有良好的科学思维，扎实的医学基础理论和法医学专业知识，掌握司法鉴定基本技能，熟悉司法鉴定程序，德智体美劳全面发展的高级应用性专业人才。按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，要求本专业学生比较全面地掌握基础医学、临床医学以及法医学的基本理论知识，熟练应用临床医学及法医学的基本技能，具备良好的思想品德和职业道德，在德智体美劳上全面发展，同时了解相关法律，毕业时能够具备从事法医学相关鉴定的基本能力和独立工作的能力，同时具有开拓的眼界和创新思维。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"\n\n\n\n时间\n\n\n授予学位\n\n\n学位类型\n\n\n专业名称\n\n\n学段审核要求\n\n\n\n\n5年级\n\n\n医学学士\n\n\n&nbsp;\n\n\n法医学\n\n\n□ 按照不少于总学分比例&nbsp; %\n\n\n\n\n☑ 按照不少于学分数&nbsp;&nbsp;&nbsp; 193\n\n\n\n\n☑ 必修课组须通过&nbsp;&nbsp;\n\n\n通识教育课程 39 学分\n\n\n\n\n专业培养课程 80 学分\n\n\n\n\n专业进阶模块 26 学分\n\n\n\n\n任意选修&nbsp; 学分\n\n\n\n\n融合创新能力实验模块 2 学分\n\n\n\n\n融合创新能力实训模块 46 学分\n\n\n\n\n□ 其他&nbsp;&nbsp;&nbsp; 通过本科毕业理论考和操作考\n\n\n\n"},{"title":"学分要求","text":""},{"title":"学位要求","text":"本科学位\n1.五年级结束时，如达到学士学位要求者授予医学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n法医学专业以基础医学、临床医学课程为培养基础，以法医学课程为培养内核，通过逐级递进和紧密衔接的培养，引导学生扎实掌握法医学基础理论和实践技能，实现培养卓越法医学专业人才的目标。通过多元培养途径激发学生原动力，鼓励优秀本科生在学习上更自主，勇于挑战自我，磨砺自我。\n2.科研训练体系\n建立全周期科研和实践训练体系，新生入学后进入克卿书院，配备“书院导师”和“新生导师”，利用导师组活动推动学生和导师的密切交流，引导学生对未来职业规划的思考，并在二年级后指导学生学业和培养路径的选择。学院同时组织科研导师面对面沙龙等活动，增进学生对学院科研工作的了解，帮助学生选择科研方向，并尽早接触科研实践活动。学生可以通过本科生科创项目确认“科研导师/专业实习导师”，在其指导下完成科创项目及毕业论文。\n"}]}