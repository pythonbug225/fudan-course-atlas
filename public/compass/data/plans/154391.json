ts":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"18","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满18学分。要求修读1个非本专业独立开设的微专业（学程），学程课程详见教务处微专业项目网页。达到该微专业最低学分要求（如15学分）后，不足部分可选修该微专业其他课程或环境科学专业进阶模块课程。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"18","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满18学分。要求修读1个创新创业学院开设的创新创业学程微专业（学程），创新创业微专业课程详见教务处微专业项目网页。达到该微专业最低学分要求（如15学分）后，不足部分可选修该微专业其他课程或环境科学专业进阶模块课程。","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"/","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"/","reference":false,"referenceId":null,"courses":[]},{"id":"2~18","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":14.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"14","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"ESE20007","name":"环境监测实验","credits":2.0,"required":false,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE20016","name":"野外实习","credits":1.0,"required":true,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BIOL30012","name":"环境生物学实验","credits":1.5,"required":false,"term":"3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE30005","name":"生产实习","credits":1.0,"required":true,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE50088","name":"环境综合创新实践","credits":3.0,"required":false,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE40001","name":"毕业论文","credits":3.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE30007","name":"环境工程学实验","credits":1.0,"required":false,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE50059","name":"环境化学实验A","credits":2.0,"required":false,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE50054","name":"环境科学与工程虚拟仿真实验","credits":2.0,"required":false,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE20022","name":"环境健康实验","credits":2.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE50068","name":"环境政策与时事述评","credits":2.0,"required":false,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ESE20010","name":"生态学实验","credits":1.5,"required":false,"term":"3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":94,"completeModules":true,"fetchedAt":"2026-10-31T16:44:30Z","programNotes":[{"title":"学科专业简介","text":"复旦大学环境科学与工程系成立于1996年，主要学科方向为环境科学、环境工程、环境健康以及生态管理。拥有环境科学与工程一级学科博士点，可授予学士、硕士、博士学位。2017年环境科学与工程学科入选教育部“一流学科”建设计划，2022年再次入选教育部“一流学科”建设计划；2021年环境科学专业入选国家级一流本科专业建设点。有国家科技部气候变化与环境研究国际科技合作基地、国家级环境科学虚拟仿真实验教学中心等教学科研平台。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的环境科学专业领军人才。学生应具有良好的思想道德素质和科学的世界观，具有人文情怀，具备突出的科学素养与创新思维、开阔的国际视野和跨文化环境下的交流与合作能力，能够服务国家重大战略需求。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"\n\n\n\n1.修业年限：4年\n\n\n\n\n2. 学位授予说明：\n\n\n\n\n授予学位\n\n\n学位类型\n\n\n专业名称\n\n\n学段审核要求\n\n\n\n\n理学学士+工学学士\n\n\n/\n\n\n环境科学-智能科学与技术（人工智能方向）双学士学位项目\n\n\n按照不少于学分数 167\n\n\n\n\n必修课组须通过\n\n\n通识教育课程36学分\n\n\n\n\n专业培养课程99学分\n\n\n\n\n专业进阶模块18分\n\n\n\n\n融合创新能力模块14分\n\n\n\n"},{"title":"学分要求","text":"\n1. 专业进阶路径：167学分\n本路径需要完成167学分（含实践学分不低于41.75学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程99学分、专业进阶模块修读18学分、融合创新能力培养14学分。\n2. 本科荣誉项目：173学分\n须在完成专业进阶路径的要求的同时，修读至少24学分由环境系开设的荣誉课程。荣誉项目课程设置和修读要求请见环境科学与工程系“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n3. 跨学科学发展路径：167学分\n本路径学生需要完成167学分，包括通识教育课程36学分、专业培养课程99学分、融合创新能力模块14学分、修读1个跨学科微专业（学程）18学分。"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予理学、工学双学士学位。&nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到环境系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见环境系“本科荣誉项目”实施方案。"},{"title":"课程体系与科研训练体系","text":"&nbsp; &nbsp;"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过37学分。"}]}