pulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":1.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM40001","name":"教学实习","credits":4.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM40003","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50029","name":"记录中国（专业实践）","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50004","name":"大江东—复旦融媒体创新工作室","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50003","name":"新闻实务工作坊","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM40010","name":"社会调研与育人实践","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM10005","name":"学生发展与生涯规划","credits":1.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":90,"completeModules":true,"fetchedAt":"2026-10-31T16:46:00Z","programNotes":[{"title":"学科专业简介","text":"复旦大学新闻学院前身为复旦大学新闻系，创办于1929年，是中国赓续历史最悠久的新闻传播教育机构，素有“复旦新闻馆，天下记者家”的美誉。近百年来，复旦新闻学院遵循“好学力行”的院训，作育国士，培养栋梁，形成了贯通本硕博的全链条人才培养体系。学院首批获得新闻传播学一级学科学位授予权，包含新闻学、传播学两个国家重点学科。拥有全国首家新闻传播学博士后流动站、国家级教材建设重点研究基地、教育部人文社会科学重点研究基地、教育部国际传播联合研究院、全球传播全媒体研究院等重要研究平台以及国家级实验教学示范中心。在最新一次全国学科评估中，复旦新闻传播学科被评为“A+”。学院与美国密苏里大学、英国伦敦政治经济学院、法国巴黎政治大学、澳大利亚墨尔本大学、荷兰阿姆斯特丹大学、日本早稻田大学等数十所世界一流新闻传播院校建立了紧密的人才培养和学术合作关系。近年来，按照“主流化、数字化、国际化”理念，全方位改革人才培养体系，推出望道新闻卓越班、数字视听、战略传播本硕融通项目，开设“新闻+AI”“传播+AI”双学位，培养堪当时代大任的创新型、复合型新闻传播人才。学院呼应智能时代发展趋势，推动科研范式创新，提升国际学术对话能力，打造一流新闻传播学科。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2 是通识和专业教育，X 是多元发展路径，Y 为融合创新能力）为途径，培养德智体美劳全面发展，具有坚定正确的政治方向，培养兼具新闻传播知识和人工智能技术运用能力的应用型、创新型、复合型人才。在专业核心知识和能力上，学生要具备扎实的科学素养与深厚的人文社会科学底蕴，具有服务国家、服务人民、服务中国特色社会主义的社会责任感，掌握新闻传播基本知识，了解人工智能技术的基本原理，在此基础上具有一定的数据思维、系统架构能力和算法技术能力，具有针对新闻传播应用场景的人工智能技术实践和创新能力。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"&nbsp;\n&nbsp;"},{"title":"学分要求","text":"\n1、专业进阶路径：189学分&nbsp;&nbsp;\n本路径学生本硕期间必须修满教学计划规定的189学分，包括通识教育课程39学分、专业培养课程109学分、专业进阶模块23学分（研究生课程不少于10学分）、融合创新能力培养模块18学分。其中，本科学段需要完成160学分（含实践学分不低于26学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程101学分、专业进阶模块修读13学分、融合创新能力培养10学分。\n2、本科荣誉项目：189学分&nbsp;\n荣誉项目课程设置和修读要求请见新闻学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n3、跨学科发展路径：205学分&nbsp;&nbsp;\n微专业（学程）课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成微专业（学程）修读要求的学生可获得相应的微专业（学程）证书。"},{"title":"学位要求","text":"（一）本科学位&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n\n4年级结束时，如达到学士学位要求者授予文学、工学学士学位。\n\n&nbsp; （1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n&nbsp; （2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n&nbsp; （3）在此基础上，达到新闻学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见新闻学院“本科荣誉项目”实施方案。&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n\n本科学段主动退出和转段考核不合格退出本硕融通计划的学生，需按照新闻学专业本科“2+X+Y”培养方案修读课程，如达到学士学位要求者授予文学学士学位。\n\n（二）研究生学位\n\n达到硕士学位要求者授予文学硕士学位。\n\n&nbsp; （1）必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于2.5。\n&nbsp; （2）学位论文通过预审、相似性检测、评阅及答辩。详见《复旦大学博士、硕士学位论文预审办法》《复旦大学博士、硕士学位论文相似度检测工作的实施办法》《复旦大学博士、硕士学位论文双盲评审办法》《复旦大学博士、硕士学位论文答辩组织办法》《复旦大学新闻传播学硕士学位授予标准》等相关文件。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n以29门课程为基础建立了本硕融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本硕融通的专业进阶课程体系。\n\n\n\n备注\n课程代码数字部分的第一位代表了课程难度等级。\n\n\n每学期选修学分不得超过32学分。\n\n\n\n2.实践训练体系\n构建以实务课程、大江东-复旦融媒体创新工作室、记录中国、、社会调研与育人实践、新闻实务工作坊、教学实习、校园媒体实践等多种形式构成的实务训练体系，提升学生在现实场景中从事新闻生产的能力。\n3.科研训练体系\n本科阶段设立研究方法课程和文献阅读课程，学生申报“复芏计划”，参与导师课题，激发学术研究的兴趣。研究生阶段强化研究方法训练，提升理论素养，加强学术规范教育，鼓励学生自主开展学术研究。多渠道支持学生参加国内国际高水平学术交流。\n"}]}