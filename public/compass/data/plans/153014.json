uireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":3.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"8","name":"专业外语","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CS20006","name":"课题组轮转","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"CS30010","name":"综合实践","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"学位核心课","nameEn":null,"id":1,"code":"1","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-20T12:45:06.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"学位核心课"}}},{"code":"CS30011","name":"前沿探索","credits":3.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":{"nameZh":"学位核心课","nameEn":null,"id":1,"code":"1","enabled":true,"createdDateTime":null,"updatedDateTime":"2025-06-20T12:45:06.000","bizTypeAssocs":[2],"bizTypeIds":[2],"transient":false,"name":"学位核心课"}}},{"code":"CS40009","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":146,"completeModules":true,"fetchedAt":"2026-10-31T16:44:37Z","programNotes":[{"title":"学科专业简介","text":"复旦大学计算与智能创新学院秉承计算机科学与技术专业多年的人才培养经验，积极响应国家重大发展战略和复旦大学新工科本研融通的新举措，充分依托综合性大学优势，聚焦计算机科学、计算机工程和计算机应用全能型的人才培养，造就具有扎实的理论基础、树立计算机系统观点、熟悉计算机科学与工程核心原理、具备计算机系统能力、具有国际视野和参与国际竞争与协作的全能型人才，为中国乃至世界的计算机科学探索、计算机工程实施和计算机应用健康持续发展提供强有力的人才支撑。"},{"title":"培养目标","text":"旨在培育具有深厚底蕴与前瞻视野的计算机科学与技术领域精英。学生将系统掌握计算机领域的核心理论、专业知识及实操技能，同时在数理科学等多个维度实现跨领域融合的综合素养。要求学生精通至少一门外语，具备卓越的问题解析、独立研究等能力。通过本研融通培养，构建起循序渐进、层层深入的学习路径，为学生的成长与发展提供持续且强劲的动力，助力其在计算机科学与技术领域稳步迈向顶尖行列。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"\n&nbsp;\n1、专业进阶路径：157&nbsp;学分\n&nbsp;&nbsp;本路径学生本硕期间必须修满教学计划规定的 157&nbsp;学分，包括通识教育课程39学分、专业培养课程 65 学分、专业进阶I修读 20 学分、专业进阶II修读 15 学分、融合创新能力培养 18 学分。&nbsp;&nbsp;&nbsp;&nbsp;其中，本科学段需要完成 143 学分（含实践学分不低于 36 学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程 36 学分、专业培养课程 65 学分、专业进阶模块修读 35 学分、融合创新能力培养 7 学分。\n2、 &nbsp;&nbsp;&nbsp;荣誉项目：157&nbsp;学分\n&nbsp;&nbsp;&nbsp;&nbsp;荣誉项目课程设置和修读要求请见本学院本科“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n3、跨学科发展路径：172学分\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;在专业进阶路径或荣誉项目基础上，修读1个非本专业独立开设的微专业（学程）15学分，具体要求见教务处微专业（学程）实施方案。"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予理学学士学位。 &nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n2. 本科学段主动退出和转段考核不合格退出本硕融通计划的学生，需按照本专业本科“2+X+Y”培养方案修读课程，如达到学士学位要求者授予理学学士学位。\n（二）研究生学位\n达到硕士学位要求者授予电子信息硕士学位：（1）硕士学位申请人提出学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于 2.5。 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;（2）硕士学位授予标准院系补充说明：按照《复旦大学学位授予工作细则》的规定执行。专业学位硕士生申请学位没有发表学术论文的要求。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n&nbsp;\n\n2.科研训练体系\n针对本硕融通计划学生在二年级下学期设置《课题组轮转》，要求学生在3个以上不同课题组开展无学分轮转，通过参加讨论班以及交流讨论等方式了解不同研究方向并考虑自身科研兴趣。学期结束后初步确定导师及课题组。在三年级上学期设置《综合实践》课程，在指导教师组的带领下完成一个与本专业研究方向密切相关的专业能力综合实践。本硕融通项目邀请企业和行业导师参与同时突出强调系统及工程实践能力。学期结束后正式确定导师及课题组。在三年级下学期设置《前沿探索》课程，在课题组导师指导下完成一个与本专业研究方向密切相关的科研课题。本硕融通项目突出强调系统及应用型研究，可邀请企业和行业导师参与指导，最终成果体现为学术论文、技术报告、工具系统、开源项目或科创竞赛项目等（可合作完成）。同时，鼓励学生结合《综合实践》和《前沿探索》课程申请FDUROP项目，并参与导师课题组的科研工作。"}]}