RequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"55","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求至少修读本专业进阶模块I（15学分）和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。\n    辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可在主修专业的学士学位证书中获得相应辅修学士学位注记。","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"选择多元发展课程模块和学程时，专业进阶课程模块和辅修学士学位项目可以冲抵学程，专业培养和多元发展路径共享的课程只计算一次学分。","reference":false,"referenceId":null,"courses":[]},{"id":"2~27","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":21.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"21","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"CHEM20004","name":"合成化学实验(上)","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHEM30003","name":"合成化学实验(下)","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MASE30008","name":"高分子学术前沿讲座","credits":2.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MASE30009","name":"生产实习","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CHEM30031","name":"物理化学实验（上）","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MASE30003","name":"科研实践","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CHEM30032","name":"物理化学实验（下）","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"MASE40013","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CHEM30042","name":"高分子实验Ⅰ","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHEM30043","name":"高分子实验Ⅱ","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":83,"completeModules":true,"fetchedAt":"2026-10-31T16:43:51Z","programNotes":[{"title":"学科专业简介","text":"复旦大学高分子科学系是我国最早从事高分子科学的教学和研究的单位之一，设有高分子材料与工程本科专业，也是“强基计划”化学(高分子化学)专业培养单位。设有高分子化学与物理硕士点、博士点、博士后科研流动站，还设有材料与化工专业硕士点、博士点，建设有聚合物分子工程全国重点实验室及上海市聚合物分子工程专业技术服务平台。高分子科学系以先进的育人理念、雄厚的师资力量、和谐的管理氛围、优质的学术成果等优势，是我国培养高分子及相关学科创新人才及开展前沿科学研究的重要基地。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，旨在培养的高分子领域具有深厚理论基础和卓越创新能力的高素质复合型人才。注重理论与实践相结合，通过系统的课程学习和科研训练，培养学生创新思维和独立解决复杂问题的能力，能够勇攀科学高峰、引领文明进步、推动技术创新的领军人才。"},{"title":"基本要求","text":""},{"title":"修业要求","text":""},{"title":"学分要求","text":"&nbsp;\n1、专业进阶路径：143学分\n本路径学生本科期间必须修满教学计划规定的143学分（含实践学分不低于36学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程59学分、专业进阶I修读15学分、专业进阶II修读9学分、融合创新能力培养模块21学分的修读。 &nbsp;&nbsp;\n2、荣誉项目：149学分\n在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见高分子科学系“荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n3、跨学科发展路径：158学分\n在专业进阶路径或荣誉项目基础上，修读1个非本专业独立开设的微专业（学程）15学分，具体要求见教务处微专业（学程）实施方案。微专业课程详见教务处微专业项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成微专业修读要求的学生可获得相应的微专业证书。\n4、高分子材料与工程+AI双学士学位项目：178学分\n本路径学生必须修满教学计划规定的178学分，包括通识教育课程36学分、专业培养课程98学分、专业进阶模块修读23学分、融合创新能力培养21学分。具体要求见高分子材料与工程-信息与计算科学（人工智能方向）双学士学位项目培养方案。&nbsp;"},{"title":"学位要求","text":"1. 四年级结束时，如达到学士学位要求者理授予学学士学位。&nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到高分子科学系“荣誉证书”获得条件的授予“荣誉证书”，具体要求请见高分子科学系“荣誉项目”实施方案。\n2. 高分子材料与工程+AI学士双学位项目，如达到高分子材料与工程-信息与计算科学（人工智能方向）要求者授予理学-工学双学士学位。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n&nbsp; &nbsp;课程上以荣誉课程为抓手，强化基础理论、交叉和科学实践类课程，建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。\n2.科研训练体系\n&nbsp; &nbsp;本科阶段引导学生早进课题组轮转，通过“复芏计划”激发创新志趣。研究生阶段强化科研训练，加强科学道德和学术规范教育，激励学生自主开展学术研究。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内外高水平创新竞赛，以赛促教、促学、促研。"},{"title":"课程设置与修读要求","text":"智能穿戴于同隐班同学必修通识微课《智能纤维与可穿戴电子世界》（GECC10123）；\n选择一对一导师时可优先选择智能穿戴方向导师。"}]}