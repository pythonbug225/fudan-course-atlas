":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~29","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":20.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"20","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础型—综合型—创新型”渐次推进、相互衔接的物理实验教学体系，在解决复杂问题的过程中培养实验技能，激发批判性思维和科研潜力。\n2. 全周期的科研训练体系，在1、2年级设立物理前沿导论课和无学分讨论班，引导学生早进课题组轮转，培育兴趣。3年级通过2学期的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。\n3. 多渠道支持学生参加国内国际高水平学术交流，原则上应到具有世界一流水平的国内外机构进行一年左右（累计）的学习、研究或联合培养。鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛、全国大学生物理实验竞赛、中国大学生物理学术竞赛等）。","reference":false,"referenceId":null,"courses":[{"code":"101","name":"无学分讨论班","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHYS10009","name":"大学物理实验Ⅰ","credits":2.0,"required":true,"term":"1","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS10011","name":"物理前沿导论","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS20015","name":"大学物理实验Ⅱ","credits":2.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS30008","name":"科研实践Ⅰ","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS20016","name":"大学物理实验Ⅲ","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS30009","name":"科研实践Ⅱ","credits":3.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS30013","name":"近代物理实验I","credits":4.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS40002","name":"本科毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":76,"completeModules":true,"fetchedAt":"2026-10-31T16:45:47Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; 复旦大学物理学系创建于1952年的全国高校院系调整。现有物理学国家一级学科，为国家双一流建设学科、国家级一流本科专业、上海市高峰学科，下设理论物理、凝聚态物理和光学三个二级国家重点学科，入选教育部“基础学科拔尖学生培养计划”2.0 基地。物理学科秉承“格物、致知、明理、通达”的理念，以先进的育人理念、雄厚的师资力量、和谐的管理氛围、优质的学术成果等优势被公认为国内最强的物理学科之一。"},{"title":"培养目标","text":"&nbsp; 按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的物理学领军人才。学生应具有良好的思想道德素质和科学的世界观，具有人文情怀，具备突出的科学素养与创新思维、开阔的国际视野和跨文化环境下的交流与合作能力，能够服务国家重大战略需求。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"1、修业年限：4年\n&nbsp;"},{"title":"学分要求","text":"\n物理+AI双学士学位项目：177学分\n本路径学生必须修满教学计划规定的177学分（含实践学分不低于44.25学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程106学分（其中学科基础课程33学分，物理专业核心课程38学分，AI专业核心课程35学分）、专业进阶模块修读15学分、融合创新能力模块20学分。"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予理学学士学位。 &nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到物理学系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见物理学系“本科荣誉项目”实施方案。\n2. 物理+AI学士双学位项目，如达到物理学-人工智能双学士学位要求者授予理学-工学双学士学位。"},{"title":"课程体系与科研训练体系","text":"1. 课程体系\n以14门高难度、大学分的荣誉课程为基础建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。为鼓励学生挑战自我，5门普通物理课程设置免修制度，免修考试通过后可直接修读后续高阶理论课程，6门高阶理论课程每学期都开设，可随时修读。鼓励学生修读荣誉课程。\n2. 科研训练体系\n建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师/拔尖导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在1、2年级设立物理前沿导论课和无学分讨论班，引导学生早进课题组轮转，培育兴趣。3年级通过2学期的科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}