m":true,"showRequiredCredits":"0","requireAll":true,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"32","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"跨学科发展路径要求在专业进阶路径基础上，修读1个跨学科微专业（学程）15学分。","reference":false,"referenceId":null,"courses":[]},{"id":"-105","rawId":"-105","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~33","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":19.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"19","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1. 按照“基础型—综合型—创新型”渐次推进、相互衔接的大气与海洋实验实践实训教学体系，在解决复杂问题的过程中培养实践技能，激发批判性思维和科研潜力。\n2. 全周期的科研训练体系，在1、2年级设立海洋调查实践和无学分讨论班，引导学生早进课题组轮转，培育兴趣。3年级通过气象预报与预测实践、专项科研训练、专业实习等科研实践训练，完成1项复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），鼓励学生参加国际暑期学校，激发创新志趣。","reference":false,"referenceId":null,"courses":[{"code":"ATMO20007","name":"大气探测","credits":5.0,"required":true,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"101","name":"无学分讨论班","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO40001","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS10005","name":"基础物理实验","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO30006","name":"专业实习","credits":1.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ATMO20009","name":"海洋调查与实践","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO30014","name":"气象预报与预测实践","credits":3.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO30016","name":"专业科研训练Ⅰ","credits":1.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO30017","name":"专业科研训练Ⅱ","credits":1.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ATMO737001","name":"气候变化及其风险","credits":3.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHEM10005","name":"普通化学实验I","credits":1.0,"required":true,"term":"1","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":87,"completeModules":true,"fetchedAt":"2026-10-31T16:43:43Z","programNotes":[{"title":"学科专业简介","text":"大气科学-人工智能双学士学位项目旨在培养兼具大气科学专业素养与人工智能技术能力的复合型人才，满足社会在应对气候变化、环境监测、气象灾害预测等领域对高端人才的需求。学生将系统学习大气科学与人工智能的核心课程，通过实际项目锻炼，提升解决复杂问题的能力，为相关行业智能化发展贡献力量。"},{"title":"培养目标","text":"&nbsp; 本专业培养具有良好科学素养和创新意识，能在大气科学及相关学科中从事科研、教学、技术应用和管理等方面工作的高级专门人才。&nbsp; 按照“科学基础宽厚，学科支柱坚实，专业特色明显”的人才培养要求，全面提升学生的综合素质。使学生具有良好的思想道德素质和科学的世界观；系统扎实地掌握大气科学的基本理论和基本实验方法，具备必需的数理基础知识；具有宽广的知识面，了解大气科学的前沿和发展动态，了解相关学科的一般知识，具有较高的科学人文素养；得到初步的科研训练，掌握基本的科研方法，熟练利用外语和现代技术手段获取专业资料。&nbsp;"},{"title":"基本要求","text":""},{"title":"修业要求","text":""},{"title":"学分要求","text":"\n&nbsp;\n1.专业进阶路径：169学分\n本路径学生需要完成169学分（含实践学分不低于43学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程97学分、专业进阶模块17学分（其中基础模块需修满3学分，理论与应用模块需修满5学分、AI基础AI交叉模块需修满9学分）、融合创新能力模块19学分。\n2.本科荣誉项目：174学分\n在专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见大气与海洋科学系“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。\n3.跨学科学发展路径：184学分\n本路径学生需要完成184学分，包括通识教育课程36学分、专业培养课程97学分、专业进阶模块17学分（其中基础模块需修满3学分，理论与应用模块需修满5学分、AI基础AI交叉模块需修满9学分）、融合创新能力模块19学分、修读1个跨学科微专业（学程）15学分。"},{"title":"学位要求","text":"&nbsp; 大气科学+AI学士双学位项目，如达到大气科学-人工智能双学士学位要求者授予理学-工学双学士学位。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n&nbsp; 课程对接国家基础研究和“新工科”建设需求，面向大气科学与计算机科学跨学科领域，涵盖大气科学核心课程与计算机科学核心课程，融合跨学科实践项目培养德智体美劳全面发展的复合型拔尖创新人才。\n2.科研训练体系\n&nbsp; 本科阶段设立导论课程和无学分讨论班，引导学生早进课题组轮转，通过“复芏计划”激发创新志趣。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内外高水平创新竞赛，以赛促教、促学、促研。\n"}]}