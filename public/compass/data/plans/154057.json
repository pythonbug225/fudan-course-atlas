edits":3.0,"required":false,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CS30021","name":"计算理论基础","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"AIE410002","name":"自然语言处理与大语言模型","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CS30034","name":"计算机视觉","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CS30055","name":"云计算与虚拟化技术","credits":3.0,"required":false,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CS30006","name":"计算机图形学","credits":3.0,"required":false,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CS30033","name":"分布式系统","credits":3.0,"required":false,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"CS30058","name":"机器学习系统","credits":3.0,"required":false,"term":"7,8","rule":{"requiredCourse":null,"integrationCompulsory":false,"postGraduateDegreeType":null}}]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":6.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"6","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"鼓励并帮助学生在完成德语基本功训练和文学基本素养培育的同时，积极申请复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发创新志趣。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（“外教社杯”全国高校英语演讲比赛、“外研社·国才杯”“理解当代中国”全国大学生外语能力大赛英语组、翻译组及全国口译大赛，韩素英翻译大赛等）。","reference":false,"referenceId":null,"courses":[{"code":"101","name":"无学分讨论班","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"FORE30001","name":"实习调查","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"FORE40080","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":78,"completeModules":true,"fetchedAt":"2026-10-31T16:45:29Z","programNotes":[{"title":"学科专业简介","text":"本双学位项目所依托的两个专业（即“翻译”以及“计算机科学与技术”专业），均为国家级一流本科专业。近年来，复旦大学翻译系和计算机科学技术学院一直保持跨学科学术合作，并在大语言模型、深度学习与机器翻译等领域取得了系列研究成果。翻译系已有多位本科毕业生进入计算机领域继续学习深造，并在翻译技术竞赛中获得优异成绩。同时计算机科学技术学院也不断吸纳文科优秀学生至计算机领域攻读研究生。在此基础上，本双学位项目旨在深化文理交叉，探索更系统、更持久的跨学科培养路径。"},{"title":"培养目标","text":"本专业对接国家“新文科”“新工科”建设的需求，旨在培养德智体美劳全面发展，具有扎实语言功底、良好人文素养、宽阔国际视野，较强的英汉两种语言与文化的转换和沟通能力，兼具计算机科学跨学科背景、符合国家建设和社会发展所需要的复合型拔尖创新人才。要求学生掌握英汉口笔译能力；具有较强的跨文化交际能力；具有扎实的英语语言基础和较熟练的听、说、读、写、译能力；具有第二外国语的一定的实际应用能力；熟练运用双语能力在涉外场合进行语言与文化的沟通和组织工作；具有良好的汉语表达能力和基本调研能力；具有扎实的计算机软、硬件基本理论、基本知识和基本实践技能；具有能够将数字工具和理论运用到语言信息处理、人工智能开发、数字人文研究等跨学科领域的创新意识和能力。"},{"title":"基本要求","text":"\n&nbsp;"},{"title":"修业要求","text":"1.修业年限：4年（类型：■本科、□本硕、□本博）\n2.学位授予说明：\n"},{"title":"学分要求","text":"\n1、 &nbsp; &nbsp;专业进阶路径：167学分\n&nbsp; &nbsp; 本路径学生需要完成167学分（含实践学分不低于26学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程34学分、专业培养课程109学分、专业进阶课程18分、融合创新能力模块6学分。\n2、 &nbsp; &nbsp;本科荣誉项目：167学分\n&nbsp; &nbsp; 在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见翻译专业“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。&nbsp;"},{"title":"学位要求","text":"4年级结束时，如达到学士学位要求者授予文学、理学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到翻译专业“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见翻译专业“本科荣誉项目”实施方案。"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系\n以覆盖语言能力训练和口笔译能力培育的课程为基础建立了翻译专业核心课程体系，以课程内容和能力要求为梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。\n2.科研实践体系\n鼓励并指导学生参与各类口笔译及语言文化能力竞赛，引导学生进入系内教师课题组轮转，培育科研兴趣。通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”，激发创新志趣。"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}