m":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~17","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":7.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"7","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"1.多渠道支持并资助学生参加国外世界一流水平高校进行一学期的学习与交换。\n2.全员参加“朝阳行动”，教授带队，学以致用，培养高度的社会责任感。\n3.体验科研训练，在解决复杂问题的过程中，激发批判性思维和科研潜力。鼓励完成1项复芏计划（FDUROP）项目，激发创新志趣。","reference":false,"referenceId":null,"courses":[{"code":"BA30055","name":"社会调查","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BA40001","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BA40002","name":"毕业实习","credits":1.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":64,"completeModules":true,"fetchedAt":"2026-10-31T16:43:57Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; 复旦大学管理学院金融与财务学系成立于1993年，其前身是复旦大学管理学院经济管理系的财务学专业，是我国最早将财务金融专业独立设系的院系之一。该系师资力量雄厚，共有教师21人，教授12人，其中博士生导师11人；副教授7人、讲师1人、青年副研究员1人，海外博士占62%。在学科专业设置方面，下设财务管理本科专业1个，财务管理和金融工程管理硕博连读点2个，以及财务学博士点1个，承担学院的财务管理和金融工程专业金融硕士的培养工作。研究领域广泛，包括公司财务、资本市场、投资管理、资产定价、国际金融、金融工程、宏观经济、计量经济、绿色金融、金融科技、风险投资、创新创业等。承担了多项国家级科学研究基金项目，完成多项企业调研咨询项目，取得了多项重要研究成果。在教学与人才培养上，注重理论与实践结合，通过专业课程、讲座与交流等形式，让学生掌握扎实的专业知识，了解行业前沿动态。三十年来，该系培养了大批优秀人才，他们大多在国际及国内金融机构、跨国公司、咨询公司等从事金融、投资和财务工作，或在高校、政府及行业研究机构、交易所等从事教学和研究工作。&nbsp; &nbsp;“财务管理（金融与财务）-人工智能”双学士学位项目打通财务管理（金融与财务）与AI双学位培养路径，充分发挥两学科优势，开展跨学科融合教育，贯彻“财务管理+”深度交叉融合培养理念，探索复合型卓越人才培养新模式。"},{"title":"培养目标","text":"&nbsp; &nbsp; &nbsp; 按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，本专业对接国家和上海市政府提出AI专业人才培养的建设需求，旨在培养德智体美劳全面发展，具备管理、经济、法律和金融财务等方面的知识和能力，兼具人工智能等跨学科背景，能在工商、金融企业、事业单位及政府部门的实际工作中熟练灵活地运用人工智能作为工具，从事金融、财务管理以及教学科研方面工作的工商管理学科高级专门人才。&nbsp; &nbsp; 本专业要求学生掌握管理学、经济学和金融与财务的基本理论和基本知识；掌握金融、财务管理的定性、定量分析方法；具有较强的信息获取及分析和解决财务、金融管理实际问题的基本能力；熟悉我国有关财务、金融管理的方针、政策和法规；了解本学科的理论前沿和发展动态；掌握文献检索、资料查询的基本方法，具有一定的科学研究能力和较强的实际工作能力；具有扎实的人工智能基本理论、基本知识和基本实践技能；具有能够将人工智能结合财务金融领域各项工作的跨学科的创新意识和能力。&nbsp;&nbsp; &nbsp; &nbsp;&nbsp;"},{"title":"基本要求","text":""},{"title":"学分要求","text":"&nbsp;\n\n1、&nbsp; 专业进阶路径：139学分&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n本路径学生需要完成139学分（含实践学分不低于35学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程12学分、专业培养课程91学分、专业进阶模块I修读29学分、融合创新能力模块7学分。\n2、&nbsp; 本科荣誉项目：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n在3个专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见管理学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n3、 跨学科学发展路径：139学分&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n微专业（学程）详见https://ehall.fudan.edu.cn/&nbsp; &nbsp;搜索“ 微专业(学程)/辅修学士学位项目方案”查询。完成学程修读要求的学生可获得相应的学程证书。\n&nbsp;"},{"title":"学位要求","text":"（一）本科学位\n&nbsp; 1.&nbsp; 4年级结束时，如达到此双学士学位要求者授予管理学-工学双学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n（3）在此基础上，达到管理学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见管理学院“本科荣誉项目”实施方案。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"},{"title":"课程体系与科研训练体系","text":"\n注：上图供参考，以课程列表为准。"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}