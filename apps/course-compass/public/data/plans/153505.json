":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~26","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":8.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"8","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"ECON10001","name":"走进经济学系列讲座","credits":0.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON10002","name":"数据分析方法应用初步","credits":3.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON20002","name":"中国经济学系列讲座","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30002","name":"科研实践（复芏计划）","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30006","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":65,"completeModules":true,"fetchedAt":"2026-10-31T16:44:52Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; &nbsp; &nbsp;复旦大学经济学院历史悠久，师资雄厚，学科体系完备，是享誉海内外的经济学研究重镇，理论经济学和应用经济学两个一级学科分别是教育部A+学科和国家“双一流”学科。数理经济拔尖班创立于2005年，汇聚了学院最优秀的师资和学生，培养了一大批在国内外顶级高校和机构任职的精英人才，被誉为复旦大学的“经济学家摇篮”。"},{"title":"培养目标","text":"&nbsp; &nbsp; &nbsp; &nbsp;本项目依托教育部基础学科拔尖学生培养计划2.0经济学拔尖学生培养基地，按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”为人才培养途径（2是通识和专业教育，X是多元发展路径，Y为融合创新能力），培养学生具备敏锐的问题意识、扎实的经济学理论功底、前沿的数理和量化分析能力，为在国内外顶尖高校攻读相关硕士、博士学位和直接就业，成为世界一流的交叉融合创新人才打下坚实的基础。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：√本科）\n&nbsp;\n&nbsp;\n\n\n5. 学位授予说明：\n\n\n学段\n时间\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n本科生学段\n4年级\n经济学学士\n/\n经济学（数理经济方向）\n□按照不少于总学分比例____%\n\n\n√按照不少于学分数 180\n\n\n√必修课组须通过\n通识教育课程36学分\n\n\n专业培养课程114学分\n\n\n专业进阶模块22学分\n\n\n融合创新能力培养8学分\n\n\n□其他____________________\n\n\n"},{"title":"学分要求","text":"\n\n\n\n1、 专业进阶路径：180学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 本路径学生需要完成180学分（含实践学分不低于32学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、专业培养课程114学分、专业进阶模块修读22学分、融合创新能力模块8学分。\n\n\n2、 本科荣誉项目：180学分\n\n\n&nbsp;&nbsp; 在专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见经济学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。&nbsp;\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n1. 4年级结束时，如达到学士学位要求者理授予学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到经济学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见经济学院“本科荣誉项目”实施方案。\n\n\n2. 经济学（数理经济方向）+AI学士双学位项目，如达到经济学（数理经济方向）-人工智能双学士学位要求者授予经济学-工学双学士学位。\n\n\n"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n\n&nbsp; &nbsp; &nbsp; 以经济学基础理论和数理基础和方法课程为基础建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。 鼓励学生修读荣誉课程。&nbsp; &nbsp; &nbsp;以8门高难度、大学分的荣誉课程，6门高难度、两阶段的“三高”课程（高微、高宏、高计）为基础建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。为鼓励学生挑战自我，数理基础和方法模块设立多门AI等交叉融合必修课程，夯实数理基础，提升分析能力。\n2.科研训练体系\n&nbsp; &nbsp; &nbsp; 本科阶段，1、2年级设立走进经济学系列讲座和中国经济学系列讲座，引导学生认识经济学、喜欢经济学；激发学生对经济学科的兴趣，培养实践能力。3、4年级通过完成科研实践、创新实践、学术实践和社会实践等，激发创新志趣，引导学生洞察现实，参加导师（组）讨论班，通过“复芏计划”激发创新志趣。研究生阶段强化科研训练，加强科学道德和学术规范教育，激励学生自主开展学术研究。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内外高水平创新竞赛，以赛促教、促学、促研。"}]}