ourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"10","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"1021","name":"其他本科生学术研究计划","credits":4.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"POLI40012","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"POLI40011","name":"社会实践","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":81,"completeModules":true,"fetchedAt":"2026-10-31T16:44:11Z","programNotes":[{"title":"学科专业简介","text":"复旦大学国际关系与公共事务学院成立于2000年11月，前身为1923年建立的复旦大学政治学系。百年政心赓续，问道政学、作育国士。目前拥有政治学和公共管理两个国家A类学科，是国家“双一流”学科建设单位，在世界大学专业排名中稳居前列。秉承“卓越为公”理念，培养新时代具有全球视野、国家意识和专业才能的领军人才。复旦大学公共管理学为行政管理专业，是国内最早设立行政管理本科专业、国家级一流本科专业，首批设立公共管理一级学科博士点及博士后流动站设站的单位之一，也是全国首批公共管理专业学位硕士（MPA）培养机构，形成了完善的本-硕-博一体化人才培养体系。复旦大学公共行政系承担行政管理、公共政策、应急管理与政府运行保障管理等二级学科的建设与发展任务。"},{"title":"培养目标","text":"本项目对接国家和上海市政府提出的人工智能（AI）专业人才培养的建设需求，秉持“宽口径、厚基础、重能力、求创新”的人才培养理念，培养德智体美劳全面发展，拥有扎实的公共政策与行政管理理论基础以及人工智能基础知识与关键技能的复合型创新人才，能够结合公共管理、政治学、人工智能、计算机科学等跨学科背景，在党政机关、企事业单位、社会团体从事管理工作以及人工智能相关研究与开发工作。"},{"title":"基本要求","text":"要求学生系统掌握马克思主义基本原理，熟练掌握公共政策学、行政管理学、政治学、人工智能科学、计算机科学的基本理论知识；具备辩证唯物主义和历史唯物主义的基本观点和分析方法；深入了解社会治理与公共服务以及党政管理相关的法律、制度、方针、政策；熟练掌握一门外语；了解公共政策、行政管理、人工智能的理论前沿以及政治学、管理学、法学、经济学、计算机科学等相关学科的发展动态；掌握应用人工智能大模型工具以及多学科文献检索、资料查询的基本方法，具有公共政策与人工智能相关领域的科学研究能力。\n"},{"title":"学分要求","text":"本路径学生需要完成198学分（含实践学分不低于30学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程36学分、全球领导力课程模块119学分、本科多元发展模块25学分，满足融合创新能力8学分等要求。\n"},{"title":"学位要求","text":"四年级结束时，如达到学位要求者授予管理学学士学位与工学学士学位。"},{"title":"课程体系与科研训练体系","text":"&nbsp;\n\n&nbsp;\n&nbsp;\n1.课程体系 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;以3门高难度、大学分的荣誉课程为基础建立本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。鼓励学生修读荣誉课程。2.训练体系 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;春风化雨训练体系依托学院“春风化雨导师计划”面向本科轨道学生开展自选学术训练或实务训练。本科毕业时，本科轨道学生可将学术或实务训练项目成果直接作为毕业论文申请送审，也可以单独撰写毕业论文。"}]}