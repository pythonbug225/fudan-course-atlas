iredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"16","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"MASE30001","name":"新工科实践Ⅰ","credits":2.0,"required":false,"term":"3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHEM20028","name":"化学专业实验","credits":4.0,"required":true,"term":"3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40001","name":"新工科实践Ⅱ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE20011","name":"材料基础实验","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40026","name":"新材料梦工厂","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40025","name":"能源工坊","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40027","name":"能源专业实验","credits":2.0,"required":true,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40017","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE30002","name":"未来能源前沿","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40002","name":"智能材料前沿","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40023","name":"材料工程实验室安全与管理","credits":1.0,"required":false,"term":"秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"MASE40011","name":"科研项目申请及论文写作","credits":1.0,"required":false,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":97,"completeModules":true,"fetchedAt":"2026-10-31T16:46:17Z","programNotes":[{"title":"学科专业简介","text":"智能材料与未来能源创新学院以产教融合、科教融汇、育人融通为主要特色，以自主培养高水平工科拔尖创新人才为根本任务，瞄准未来信息、智能催化、智能材料、清洁能源、光电与感知等领域的学科最前沿，打造创新引领的智能材料与未来能源研究新范式，形成人工智能驱动的智能材料与未来能源学科新体系，着力强化基础研究应用转化和创新链加速机制，努力建成世界顶尖的科技创新和人才培养高地，为服务国家重大战略需求、支撑上海建设具有全球影响力的科技创新中心、回答“教育强国复旦何为”的时代命题等提供科技和人才保障。新能源科学与工程专业紧密围绕国家新能源战略需求，依托智能材料与未来能源创新学院开展专业建设与学生培养。专业打破传统专业界限，围绕“基础课程、交叉进阶、实践实训”三大模块，开设系列理论与实践深度融合课程，并建有全国领先的全流程智能机器人实验室。专业以复旦大学“2+X+Y”培养体系为路径，重点聚焦未来能源等领域，授予工学学士学位。"},{"title":"培养目标","text":"按照“宽口径、厚基础、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的未来能源领域领军人才。培养掌握理论基础知识和专业实验技能，熟悉学科发展的领跑者，能开展以基础研究为先导的工程应用、具备强化大团队协作以及重视全过程的系统集成的工科思维，能保障国家重大战略需求的科学家和工程师复合型人才。"},{"title":"基本要求","text":""},{"title":"修业要求","text":""},{"title":"学分要求","text":"\n1. 专业进阶路径：118学分本路径学生需要完成118学分（含实践学分不低于29.50学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程13学分、专业培养课程65学分、专业进阶模块修读24学分、融合创新能力模块16学分。2. 本科荣誉项目：124学分在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见《智能材料与未来能源创新学院“本科荣誉项目”实施方案》。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。&nbsp;3. 跨学科学发展路径：124学分在通识教育课程、专业培养课程、融合创新能力培养基础上，修读专业进阶I课程和一个非本专业独立开设的微专业（学程），或者修读2个非本专业独立开设的微专业（学程）。具体要求见教务处微专业（学程）实施方案。4. 创新创业路径：124学分修满30学分。至少修读专业进阶模块I（15学分），同时1个创新创业学院开设的创新创业微专业（学程）。学分不足部分可在全校所有本科生课程中任意选修。微专业（学程）课程详见教务处微专业（学程）项目网页。 &nbsp; &nbsp;5. 辅修学士学位路径：149学分至少辅修专业进阶模块I（15学分）和1个外院系开设的非化学大类、非材料大类辅修学士学位项目。辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，请访问复旦大学教务处网站https://jwc.fudan.edu.cn/获取。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位证书。"},{"title":"学位要求","text":"（一）本科学位&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4年级结束时，如达到学士学位要求者授予学士学位。（1）修满规定的学分，达到本科教学培养方案规定的各项要求。（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。（3）在此基础上，达到智能材料与未来能源创新学院“荣誉证书”获得条件的授予“荣誉证书”，具体要求请见《智能材料与未来能源创新学院“本科荣誉项目”实施方案》。"},{"title":"课程体系与科研训练体系","text":""}]}