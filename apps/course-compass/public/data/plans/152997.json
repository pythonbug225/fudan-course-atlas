code":"PHIL40025","name":"《资本论》与现代世界","credits":4.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40026","name":"繁荣与贫困：历史视野下的经济发展","credits":4.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL50049","name":"哲学阅读和写作 II","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL20001","name":"基督教哲学专题","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]},{"id":"9932609","rawId":"9932609","parent":"9932608","level":"1.1.2.1","title":"专业外语","type":"0X","rule":{"requiredSubModuleNum":0,"requiredCredits":2.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"2","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"PHIL40015","name":"哲学专业外语","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40016","name":"国学专业外语","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40017","name":"科逻专业外语","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40018","name":"宗教学专业外语","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40009","name":"藏语Ⅰ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40010","name":"藏语Ⅱ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40011","name":"巴利语Ⅰ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40013","name":"拉丁语与罗马宗教","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40014","name":"高阶拉丁语","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40019","name":"梵语Ⅰ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40020","name":"梵语Ⅱ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40021","name":"梵语Ⅲ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHIL40022","name":"梵语Ⅳ","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]},{"id":"9932611","rawId":"9932611","parent":"9932534","level":"1.2","title":"融合创新能力：Y模块","type":"0X","rule":{"requiredSubModuleNum":0,"requiredCredits":7.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":3,"autoSubModuleNum":true,"showRequiredCredits":"7","requireAll":true,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"PHIL30004","name":"学年论文","credits":1.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHIL30003","name":"社会实践","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHIL40008","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":191,"completeModules":true,"fetchedAt":"2026-10-31T16:46:06Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; 复旦大学哲学学院为国家文科人才培养与科学研究基地，哲学学科为国家重点一级学科，马克思主义哲学、西方哲学和中国哲学为国家重点二级学科。在全国第四轮学科评估中与北京大学并列哲学类“A+学科”，2017年被教育部评为“一流学科”，2018年入选上海市I类高峰学科。在2021年QS世界大学学科排名中，复旦哲学学科位列全球第31位，宗教学专业位列全球第41位。此外，学院有1个教育部人文社会科学重点研究基地。哲学学院具有哲学一级学科下属的全部二级学科，近年来成立了国内首个科学哲学与逻辑学系、国内首个艺术哲学系，形成了哲学、宗教学、中国古典思想与文化、科学哲学与逻辑学、艺术哲学五大学科群集群发展态势。"},{"title":"培养目标","text":"&nbsp; 哲学类专业以马克思主义理论与方法为指导，培养德、智、体、美、劳全面发展，有一定哲学理论素养和专业基础知识，有进一步培养潜质的哲学专门人才，以及能在国家机关、 文教事业、 新闻出版、企业等部门从事实际工作的应用型、复合型人才。哲学类专业包括哲学专业、哲学（国学方向）专业、哲学（科学哲学与逻辑学方向）专业、哲学（艺术哲学方向）专业和宗教学专业。哲学类专业侧重培养学生综合掌握和运用哲学各个二级学科理论知识的能力，要求学生能够准确理解马克思主义哲学、中国哲学和西方哲学的理论和历史；具备人文科学、社会科学、自然科学的相关基础知识；掌握哲学的基本研究方法和相应的社会调查能力；熟练地掌握一门外语；具有较强的思维能力、表达能力、社会活动能力和初步的科学研究能力，以及一定的管理能力。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"&nbsp;\n\n\n\n1.修业年限：4年（类型：R本科、□本硕、□本博）\n&nbsp;\n&nbsp;\n\n\n2.&nbsp;学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n哲学学士\n/\n哲学\n□按照不少于总学分比例____%\n\n\nR按照不少于学分数136&nbsp; &nbsp;\n\n\n必修课组须通过\n通识教育课程42学分\n\n\n专业培养课程53学分\n\n\n专业进阶模块34学分\n\n\n融合创新能力模块7学分\n\n\n□其他____________________\n\n\n\n&nbsp;"},{"title":"学分要求","text":"\n1、专业进阶路径：136学分&nbsp; 本路径学生需要完成136学分（含实践学分不低于21学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求）。包括通识教育课程42学分，专业培养课程53学分，融合创新能力培养7学分，专业进阶模块I 20学分，专业进阶模块II 14学分。2、本科荣誉项目：136学分&nbsp; 在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见哲学学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。&nbsp;3、跨学科学发展路径：136学分&nbsp; 本路径学生至少需要完成136学分，包括通识教育课程42学分，专业培养课程53学分，融合创新能力培养7学分，及修读2个非本专业独立开设的微专业(学程)，可选择学科微专业(学程)或跨学科微专业(学程)。学分不足部分可在全校所有本科生课程中任意选修。4、创新创业路径：136学分&nbsp;本路径学生至少需要完成136学分，包括通识教育课程42学分，专业培养课程53学分，融合创新能力培养7学分，及修读1个创新创业学院开设的创新创业微专业(学程)，以及1个非本专业独立开设的微专业(学程)。修读学分不足部分可在全校所有本科生课程中任意选修。创新创业微专业(学程)课程详见教务处微专业(学程)项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）-专业培养-常用文档。5、哲学+AI双学士学位项目：171学分&nbsp; 本路径学生必须修满教学计划规定的171学分，包括通识教育课程（含通识教育核心课程和专项教育课程）40学分、专业培养课程101学分、多元发展路径课程23学分、融合创新能力课程7学分，总学分不少于171学分（含实践学分不少于43学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），达到学位要求者授予哲学、工学学士学位。"},{"title":"学位要求","text":"1. 4年级结束时，如达到学士学位要求者授予哲学学士学位。 &nbsp;（1）修满规定的学分，达到本科教学培养方案规定的各项要求。（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。（3）在此基础上，达到哲学学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见哲学学院“本科荣誉项目”实施方案。2. 哲学+AI学士双学位项目，如达到哲学-人工智能双学士学位要求者授予哲学-工学双学士学位。"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系&nbsp; 三阶课程：以“导论”、“哲学史”为代表的大类基础课程为一阶课程；五大专业及方向（哲学、宗教学、科学哲学与逻辑学、国学、艺术哲学）核心课程为二阶课程；五大专业方向的进阶研讨类课程为三阶课程。&nbsp;两翼延伸：学术能力培养+社会实践训练，通过数智赋能的通识教育、专业培养两方面帮助学生固牢个人发展基础。此外，学生可以进一步根据自己的兴趣或个人发展规划，在导师指导下选择某一多元发展路径，根据社会经济发展需求和个人志趣实现全方位成长。\n2.科研训练体系&nbsp; 围绕复芏计划展开多种学术项目：结合曦源、望道等学术项目的公开征集课题以及个人学术兴趣申请学术项目，获取相关导师的指导，支撑具有多学科、全球化视野的“干细胞式”拔尖创新人才的培养。&nbsp; 提供大量读书班和论文研讨会：导师们举办各种主题的读书班，带领学生们深入研读哲学经典著作，帮助掌握阅读哲学原典的方法；学院建立机制保障，学生自发申请各类论文研讨会，互相点评。"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}