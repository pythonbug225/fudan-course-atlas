requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":18.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"18","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"融合创新能力:“Y”模块（18学分）\n\n1. 按照“基础型—综合型—创新型”渐次推进、相互衔接的实验教学体系，培养学生在解决复杂问题过程中掌握实验技能，激发批判性思维与科研潜力。\n2. 构建全周期的科研训练体系：在一年级和二年级开设机器人大讲堂，引导学生了解学术前沿，与大师面对面交流，培养科研兴趣；三年级安排为期两学期的科研实践训练，完成一项复旦大学本科生研究资助计划（FDUROP）项目（䇹政、望道、登辉、曦源），激发创新志趣；第五至第七学期设置科研或实践训练课程，参与项目研究与实践训练，提升科研能力。\n3. 多渠道支持学生参加国内国际高水平学术交流，原则上应到具有世界一流水平的国内外机构进行一年左右（累计）的学习、研究或联合培养。鼓励学生参加国内国际高水平创新竞赛（如中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛等）。","reference":false,"referenceId":null,"courses":[{"code":"GEEC30008","name":"设计与制造","credits":2.0,"required":false,"term":"3,4,5,6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"IST10001","name":"智能机器人与先进制造大讲堂","credits":1.0,"required":true,"term":"1,2,3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"AIE531001","name":"人工智能前沿探索实践","credits":3.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30001","name":"科研-实践训练1","credits":1.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST40004","name":"毕业论文","credits":3.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS10009","name":"大学物理实验Ⅰ","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"IST70009","name":"机电一体化系统设计","credits":3.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30002","name":"科研-实践训练2","credits":1.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS20015","name":"大学物理实验Ⅱ","credits":2.0,"required":true,"term":"3","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"AAST30039","name":"机电系统原理及实践","credits":3.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30003","name":"科研-实践训练3","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"PHYS20016","name":"大学物理实验Ⅲ","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"IST30012","name":"机器人学综合实验","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":109,"completeModules":true,"fetchedAt":"2026-10-31T16:46:22Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp;复旦大学物理学专业创建于1952年，1993年物理学系获批成为国家基础科学（理科）科研与教学人才培养基地，2007年成为国家首批物理学重点一级学科，2009年获教育部“基础学科拔尖学生培养试验计划”资助。物理学在全国第四轮学科评估中获评A级，入选国家“双一流”建设重点学科，上海市“高峰学科，2019年入选国家级一流本科专业建设点。&nbsp; &nbsp;复旦大学智能机器人与先进制造创新学院创建于2024年1月，现有智能科学与技术、航空宇航科学与技术和电子科学与技术等国家一级学科，拥有大型客机集成技术与模拟飞行全国重点实验室、智能机器人教育部工程研究中心、上海智能机器人工程技术研究中心、上海市超精密运动控制与检测工程研究中心、上海市炭化硅半导体功率器件工程技术研究中心、上海北斗智慧应用创新研究中心和上海市综合能源系统人工智能工程研究中心等十余个科研平台，并设有智能机器人与先进制造实训中心。&nbsp; 物理学（智能科学方向）依托复旦大学在数学、物理、力学、光电信息、计算机和人工智能等领域的深厚学科优势，采用本研融通的新工科“干细胞”式人才培养模式。遵循面向未来、适度超前的原则，将价值引领、知识传授与能力提升有机结合，重点培养学生的创新能力、创造能力、批判性思维能力、实践决策能力，以及沟通合作与解决问题的能力等核心素养。&nbsp; 智能机器人与先进制造创新学院致力于培养智能机器人与先进制造领域中“专业基础扎实、实践能力突出、紧跟行业趋势”的拔尖创新型人才和复合应用型人才，同时积极探索以培育顶尖科学家、原创发明家、卓越工程师和产业领袖为目标的新工科产教融合新模式。"},{"title":"培养目标","text":"&nbsp; &nbsp; 为在催生新技术和孕育新产业方面发挥引领作用，按照“科学基础宽厚，学科支柱坚实，专业特色明显”的人才培养要求，全面提升学生的综合素质。本专业培养德智体美劳全面发展，具有良好科学素养和创新意识，具备智能机器人与先进制造领域的基本理论和知识架构，能够在相关领域从事基本科学研究、教学、科技开发、产品设计或管理工作的人才。&nbsp; &nbsp; 学生应具有良好的思想道德素质和科学的世界观。培养学生具有丰富的人文素养、良好科学素养和创新意识、开阔的国际视野和跨文化环境下的交流与合作能力，掌握智能机器人、具身智能、智能光电与微纳制造等方面的基本理论、基本知识和基本技能与方法，具有本学科及跨学科的应用研究与技术开发的基本能力及适应社会需求的能力。"},{"title":"基本要求","text":"&nbsp; &nbsp; 学生应具备扎实的数学和物理基础，掌握机械、光电、控制、计算机等方面的基本理论、基本知识和基本技能；具有宽广的知识面，具备智能机器人与先进制造相关学科的专业知识，熟练利用外语和现代信息化技术手段了解该领域的前沿发展动态；具有批判精神和优秀的表达与团队协作能力，具有开展本学科及跨学科应用研究与技术开发的基本能力；得到系统科研训练，掌握基本科研方法；提高发现问题、提出问题、解决问题和获取新知识的能力，培养产生原创的“灵感”。"},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：R本科、□本硕、□本博）\n&nbsp;\n&nbsp;\n\n\n2.&nbsp;学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n理学学士\n/\n物理学\n□按照不少于总学分比例____%\n\n\nR按照不少于学分数&nbsp;145\n\n\nR必修课组须通过\n通识教育课程39学分\n\n\n专业培养课程67学分\n\n\n专业进阶模块21学分\n\n\n融合创新能力模块18学分\n\n\n□其他____________________\n\n\n"},{"title":"学分要求","text":"\n&nbsp;\n\n\n\n1、&nbsp;专业进阶路径：145学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;本路径学生需要完成145学分（含实践学分不低于37学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程67学分、专业进阶模块修读21学分、融合创新能力模块18学分。\n\n\n2、&nbsp;本科荣誉项目：150学分\n\n\n&nbsp;&nbsp;&nbsp;在专业进阶路径基础上，修读荣誉课程不低于24学分（不少于5门课）。荣誉项目课程设置和修读要求请见智能机器人与先进制造创新学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。&nbsp;\n\n\n3、&nbsp;跨学科发展路径：152学分\n\n\n&nbsp;&nbsp;&nbsp;本路径学生需要完成152学分，包括通识教育课程39学分、专业培养课程67学分、专业进阶模块I修读13学分、融合创新能力模块18学分、修读1个跨学科微专业15学分。\n\n\n"},{"title":"学位要求","text":"\n\n\n（一）本科学位\n\n\n1. 4年级结束时，如达到学士学位要求者授予理学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到智能机器人与先进制造创新学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见智能机器人与先进制造创新学院“本科荣誉项目”实施方案。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n\n\n\n1.课程体系\n\n\n以学科领域为横、课程内容梯度为纵，建立了难度逐级提升的课程体系，涵盖数学基础类、计算机和机器学习类、数智固体力学类和数智流体力学类等课程。\n\n\n2.科研训练体系\n\n\n&nbsp;&nbsp;学生需要积极参加各项机器人、人工智能、智能光电与微纳制造等领域相关竞赛，校、院级的科研训练项目等。&nbsp;&nbsp;学校或学院在学期中或暑期邀请国内外知名学者前来授课，夯实相关学科基础并促进学生充分接触前沿。鼓励学生出国出境交流。&nbsp;&nbsp;一年级上、一年级下和二年级上，参加不少于12次《智能机器人与先进制造大讲堂》报告会；二年级下，需在不少于三个课题组的讨论班进行轮转（无学分）；三年级上，进入课题组，并在三年级上至四年级上修读《科研/实践训练》Ⅰ-Ⅲ&nbsp;，期间必须获批一项FDUROP项目，参加一次院级或以上“智能机器人与先进制造”创新设计大赛。三年级下开放更换课题组机会并确定研究生导师。\n\n\n"}]}