integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"8","name":"专业外语","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"107","name":"其他","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"11","name":"硕士学位论文开题","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"31","name":"硕士论文中期考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"61","name":"硕士学位论文预审","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHYS10009","name":"大学物理实验Ⅰ","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS10001","name":"核科学与技术前沿导论","credits":2.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS20015","name":"大学物理实验Ⅱ","credits":2.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS30004","name":"科研实践Ⅰ","credits":3.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS20016","name":"大学物理实验Ⅲ","credits":2.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS30006","name":"科研实践Ⅱ","credits":3.0,"required":true,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS30013","name":"近代物理实验I","credits":4.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"NST20002","name":"专业实践","credits":1.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHYS30007","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":89,"completeModules":true,"fetchedAt":"2026-10-31T16:44:18Z","programNotes":[{"title":"学科专业简介","text":"复旦大学核科学与技术系前身为1958年成立的复旦大学原子能系（1977年改称为原子核科学系），又称物理二系。设有物理学(核物理方向)国家一级学科，下设核物理、粒子物理、原子与分子物理等学科方向。核科学与技术系秉承求实创新、追求卓越的发展理念，以先进的育人理念、雄厚的师资力量、和谐的管理氛围、优质的学术成果等优势被公认为国内最强的物理学科之一。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的物理学核物理方向领军人才。学生具有良好的思想道德素质和科学的世界观，具有人文情怀，深厚的科学素养、卓越的创新意识、开阔的国际视野。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"\n1、&nbsp; 专业进阶路径：155学分&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n本路径学生本硕期间必须修满教学计划规定的155学分，包括通识教育课程42学分、专业培养课程68学分、专业进阶模块I修读15学分（研究生课程不少于10学分）、专业进阶模块II修读5学分（研究生课程不少于5学分）、融合创新能力模块25学分的修读。\n其中，本科学段需要完成143学分（含实践学分不低于35.75学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程68学分、专业进阶模块修读15学分、融合创新能力模块21学分。&nbsp;\n2、&nbsp; 荣誉项目：160学分\n在专业进阶路径基础上，修读荣誉课程不少于5门课。荣誉项目课程设置和修读要求请见核科学与技术系“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。\n其中，本科学段需要完成148学分，包括通识教育课程39学分、专业培养课程及专业进阶模块修读88学分、融合创新能力模块21学分。\n3、 跨学科发展路径：170学分\n在专业进阶路径或荣誉项目基础上，修读1个跨学科学程（微专业）15学分（可在研究生学段修读），具体要求见教务处网站学程实施方案。\n其中，本科学段需要完成143学分，包括通识教育课程39学分、专业培养课程68学分、专业进阶模块修读15学分、融合创新能力模块21学分。\n4、硕士/X+AI双学士学位项目：199学分\n在专业进阶路径或荣誉项目基础上，修读人工智能专业项目课程47学分。具体要求见2026物理学（核物理方向）-人工智能双学士学位项目培养方案。"},{"title":"学位要求","text":"（一） &nbsp;本科学位\n1.4年级结束时，如达到学士学位要求者授予理学学士位。 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到核科学与技术系“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见核科学与技术系“本科荣誉项目”实施方案。\n2.硕士+AI学士双学位项目，如达到物理学（核物理方向）-人工智能双学士学位要求者授予理学-工学双学士学位。\n3.本科学段主动退出和转段考核不合格退出本硕融通计划的学生，需按照核科学与技术系物理学（核物理方向）本科培养方案修读课程，如达到学士学位要求者授予理学学士学位。\n（二）研究生学位\n达到硕士学位要求者授予理学硕士学位。\n（1）必须已修满学校规定的学分，所有修读课程成绩合格，其中研究生学位课程平均绩点不低于2.5。\n（2）物理学硕士学位符合以下ABC条件之一即可。\nA.发表论文要求：符合以下条件之一\n1）1篇一作 SCI论文\n2）2篇二作 SCI 论文;(影响因子总和不低于5，或均为2区及以上分区论文，物理系要求)\n3）1篇二作1区 SCI 论文\nB.从事大型科研仪器设备研制、新型实验手段建设等特殊研究工作，可降低学生发表论文要求，须在论文开题报告前向复旦大学物理学学位分委员会提出备案申请(导师或课题组提交情况说明)。\nC.从事军工项目等面向国家国防需求的研究工作，可减免学生发表论文要求，具体需按照《涉密研究生和涉密学位论文管理办法》实施。\n具体详见《现代物理研究所学位授予标准细则》"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n以高难度、大学分的荣誉课程为基础建立了本硕融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。为鼓励学生挑战自我，5门普通物理课程设置免修制度，免修考试通过后可直接修读后续高阶理论课程，5门高阶理论课程每学期都开设，可随时修读。&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n2.科研训练体系&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师／科创导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在1、2年级设立核科学与技术前沿导论课和无学分讨论班，引导学生早进课题组轮转，培育兴趣，3年级开展2学期的科研实践训练。2到3年级完成至少1项复芏计划（FDUROP）项目（曦源、莙政、望道、登辉），激发创新志趣。"}]}