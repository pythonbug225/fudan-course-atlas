awId":"-105","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~22","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":9.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"9","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"要求修读9学分。鼓励学生在读期间积极申请复芏计划（FDUROP）项目，详见复旦大学本科生学术研究资助计划管理办法。","reference":false,"referenceId":null,"courses":[{"code":"CHIN20022","name":"学年论文","credits":2.0,"required":true,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHIN20028","name":"社会实践","credits":3.0,"required":true,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHIN40076","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":197,"completeModules":true,"fetchedAt":"2026-10-31T16:46:26Z","programNotes":[{"title":"学科专业简介","text":"复旦大学中文学科创始于1917年。在100多年的发展历程中，涌现出一大批国内顶尖、世界闻名的大师学者，包括陈望道、刘大白、朱东润、谢六逸、陈子展、郭绍虞、王欣夫、吴文祺、赵景深、张世禄、蒋天枢、刘大杰、贾植芳、胡裕树、蒋孔阳、顾易生、王运熙、章培恒等先生在内的前辈学人，对中文学科乃至整个人文学科的发展都产生了深远影响。中国语言文学一级学科是国家重点学科、教育部“双一流”建设学科、上海市I类高峰学科，在教育部第五轮学科评估中位列全国顶尖。“语言学”位列2025年QS排名全球第 12。\n复旦大学中国语言文学系专业门类齐全，各专业均处于国内领先地位，同时也是国内外中文研究领域顶尖人才的培养基地。汉语言文学专业、汉语言专业均入选国家级一流本科专业建设点，同时，入选教育部基础学科拔尖学生培养计划“中国语言文学拔尖学生培养基地”。拥有首批教育部人文社科重点研究基地、首批中国语言文学博士后流动站、2011协同创新中心、首批国家语言文字推广基地。"},{"title":"培养目标","text":"本专业方向依托于汉语言、汉语言文学专业，教育和训练的重点在古文字学各个研究领域，旨在培养德智体美劳全面发展，具有语言学理论、文学理论、汉语汉字研究及中国古典文献等方面系统知识和专业技能，特别是具备古文字研究各门类基础知识，掌握相关学科基本原理和研究方法的专门人才，为进一步从事语言文字管理、应用、教学和研究打下比较扎实的基础。"},{"title":"基本要求","text":"本专业要求学生具有一定的文学理论素养和系统的汉语言文学知识，具有语言学理论、汉语汉字研究及中国古典文献等方面系统知识和专业技能，特别是具备古文字研究各门类基础知识，掌握相关学科基本原理和研究方法。"},{"title":"修业要求","text":"本专业学生实行动态管理，毕业时须满足通识教育课程（含通识教育核心课程和专项教育课程）40学分、专业培养课程65或66学分、强基专业发展课程和融合创新能力课程的修读要求。"},{"title":"学分要求","text":"本专业学生毕业时总学分不低于140或141学分（含实践学分不低于21学分或21.15学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求）。"},{"title":"学位要求","text":"本专业学生毕业时达到学位要求者授予文学学士学位。"},{"title":"课程体系与科研训练体系","text":""}]}