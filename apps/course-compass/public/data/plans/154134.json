ntegrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL60056","name":"神经生物学实验技术和方法","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30018","name":"科研实践Ⅰ","credits":2.0,"required":true,"term":"秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30021","name":"科研训练与实践 B","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL40004","name":"实用形态学与分子生物学技术","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST30019","name":"科研实践 Ⅱ","credits":2.0,"required":true,"term":"春","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL40007","name":"神经生物学前沿技术进展与实践","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST40013","name":"本科毕业论文","credits":2.0,"required":true,"term":"8,春","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL60047","name":"小动物行为实验学","credits":3.0,"required":false,"term":"春,秋","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST40015","name":"科研伦理与创新实践","credits":4.0,"required":false,"term":"7,8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"IST40016","name":"科研设计与科学写作","credits":4.0,"required":false,"term":"7,8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":64,"completeModules":true,"fetchedAt":"2026-10-31T16:45:50Z","programNotes":[{"title":"学科专业简介","text":"脑科学与类脑智能融合方向的学科专业内涵包括：结合智能领域的学科体系和前沿技术，通过对脑的基本工作原理的研究，探寻生物智能的发育和进化，生物智能的感知，以及生物智能的学习和决策机制，并启发新的智能计算模型和方法，推动新一代智能化进程。为国家培养具有智能理论基础的基础医学/生命科学领域专业人才和具有脑科学基础知识的人工智能及相关领域专业人才开辟“新赛道”；为发展脑科学与类脑智能、护佑人民健康构筑学科基石。\n复旦大学脑科学研究院作为全国第一家以“脑科学”命名的研究院成立于2006年，是复旦大学全校性的神经科学研究实体机构、教育部“985工程”二期重点建设的科技创新平台之一，也是脑科学前沿科学中心、脑功能与脑疾病全国重点实验室的研究生招生培养依托单位。以脑科学研究院为重要依托单位的神经生物学学科建设是复旦大学“双一流”学科建设、上海市“基础医学”高峰学科建设计划、上海市高水平地方高校建设计划的重要组成部分。近年来，脑科学研究院根据神经科学前沿技术最新发展，结合国家重大科研项目与战略任务实施的科研需求，不断加强平台建设，统筹资源持续引进各类新型高端设备，完善服务体系，稳步提升各项技术支撑能力，为脑科学人才培养提供高水平技术保障。多年来，脑科学研究院不断积聚脑科学及交叉学科高端人才，建设多学科交叉的国家级研究大平台，承接了科技创新2030“脑科学与类脑研究”重大项目等多个重大科研项目，取得多项重要原创成果，发表了多篇高水平论文，获得多个国家和省部级奖项，并积极推动科研成果向临床和产业转化。与此同时，研究院也积极探索建立推动学科发展和培养拔尖创新人才的新运行机制，承担了上海市研究生教育创新计划——脑科学交叉学科研究生拔尖人才培养平台建设，组建了一支以中科院院士、国家高层次人才和青年人才组成的优秀师资队伍，以国际学术前沿和国家战略需求为牵引，打造脑科学拔尖创新人才培养高地。\n复旦大学依托大数据学院、类脑智能科学与技术研究院及智能复杂体系基础理论与关键技术实验室，在“类脑智能”方向形成系统性学科布局与多平台协同创新体系。三大单位充分发挥复旦大学多学科交叉融合优势，汇聚数学、统计学、计算机科学、神经科学、生物医学工程等学科力量，形成由院士、国家级高层次人才、国家级高层次青年人才以及省部级青年人才等组成的高水平科研教学团队，承担国家级及省部级纵向科研任务200余项，建有多个教育部重点实验室及省部级平台，在相关前沿方向持续开展系统性研究与关键技术攻关。已形成稳定的研究布局与协同支撑体系：大数据学院以统计学为根基、数据科学为纽带，推动计算、统计、人工智能等多学科交叉融合；类脑智能科学与技术研究院面向脑与类脑重大科技前沿和国家重大需求，开展认知神经科学、计算生物学、计算精神病学、人工智能算法、类脑智能技术与转化等前沿基础和应用研究；智能复杂体系基础理论与关键技术实验室聚焦新型算法、高效虚拟计算空间与物理环境融合、自主动态演进等关键问题，为智能复杂体系的整合、适应与应用落地提供核心技术支撑。相关研究成果广泛发表在统计学、人工智能及脑科学领域国际顶级期刊与会议，多项成果获得国际学术奖励，并在智慧医疗、金融科技、社会治理、智能电网、智慧物流、自动驾驶等领域取得显著应用成效，整体构建起以高水平师资队伍、重大科研任务牵引和多平台协同创新为核心的类脑智能与人工智能学科体系优势。"},{"title":"培养目标","text":"按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2 是通识教育和专业教育，X 是多元发展路径，Y 为融合创新能力）为途径，面向国际科学前沿和国家重大战略需求，培养国家建设亟需的、深入掌握脑科学与类脑智能专业理论知识和实验技能，了解相关专业知识，适应学科发展需求的脑科学与类脑智能融合拔尖创新人才。学位获得者具备继续从事相关领域科学研究、技术研发、教学及管理工作的能力。具体如下：\n（1）热爱祖国，遵纪守法，品行端正，身体健康，学风严谨，有实事求是的工作作风和良好的团队合作精神，有立志报效祖国的思想境界和正确的学术道德观念。\n（2）业务能力方面：除应全面、系统、深入地掌握所学专业的基础理论知识、基本研究方法和实验技能外，还须在充分了解学科现状和最新发展动向的基础上，注重培养广阔的学术视野、独到的学术眼光、敏锐的学术嗅觉和深入的分析能力，具有独立解决相关领域的理论和应用问题、开展原创性研究的能力。善于对科研数据、文献资料进行归纳总结并做口头报告；具有基本的独立撰写科研项目申请书的能力。修读期间能够取得具有创新性的科研成果。\n（3）能够熟练阅读英文专业文献、用英语进行学术交流和撰写、发表学术论文。具有扎实的人工智能相关领域计算机理论基础和专业技能，具备与所研究领域相关的人工智能编程设计、实现、测试和应用验证能力。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"1. 专业进阶路径\n本路径学生本博期间必须修满教学计划规定的172学分，包括通识教育课程43学分、专业培养课程77学分、专业进阶修读30学分、融合创新能力培养模块22学分的修读。其中，本科学段须完成149学分：（含实践学分不低于37.35学分；含美育学分不少于2学分，其中至少在美学和艺术史论类或艺术鉴赏和评论类课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程77学分、专业进阶模块15学分、融合创新能力培养18学分。"},{"title":"学位要求","text":"(一) 本科学位\n1. 4年级结束时，如达到学士学位要求者授予工学学士学位。 &nbsp;\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（二）研究生学位\n1.达到博士学位要求者授予工学或者理学博士学位。\n学位申请人提出博士学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于2.5。\n具体参照《复旦大学学位授予工作细则》《复旦大学博士学位基本要求》或所属一级学科或专业学位类别的《学位授予标准》及院系相关文件规定执行。\n2.研究生学段主动退出和博士生资格考核不合格退出本博融通计划的学生，需按照复旦大学硕士培养方案修读课程，如达到硕士学位要求者授予理学硕士（脑科学方向）或工学硕士（类脑智能方向）学位。\n学位申请人提出博士学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于2.5。\n具体参照《复旦大学学位授予工作细则》《复旦大学硕士学位基本要求》或所属一级学科或专业学位类别的《学位授予标准》及院系相关文件规定执行。&nbsp;"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n本培养方案构建了高挑战度的涵盖数学、物理、生物、化学、脑科学与计算智能在内的学科基础课程体系，为学生奠定坚实的交叉学科知识根基。围绕生物、脑科学与类脑智能三大方向，设置由9门核心课程组成的模块化教学体系，强化学生对关键领域系统性认知。在此基础上，方案进一步设立脑科学与类脑智能两个专业进阶方向，鼓励学生根据自身兴趣与学术志向，自主选择发展路径，在导师指导下进行深入探索与个性化学习。\n2.科研训练体系\n建立螺旋递进的全周期科研训练体系，给低年级本科生配备新生导师／学业导师/产业导师，鼓励师生共创，通过包括攀登项目在内的复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在学生一年级阶段设立《相辉前沿专题》课程、在一二年级暑期开设《科研实践与训练》系列课程，引导学生早接触科研前沿、产业真实问题，早进课题组轮转、培育兴趣。二、三年级通过2个学期的科研实践训练，完成1项复芏计划（FDUROP）项目（含攀登计划），激发创新志趣。通过《科研伦理与创新实践》《科研选题与科学写作》课程帮助学生完整掌握学术规范到科研写作发表的训练。&nbsp;"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不超过32学分。"}]}