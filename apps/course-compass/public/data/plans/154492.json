eNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]}],"rowCount":115,"completeModules":true,"fetchedAt":"2026-10-31T16:44:58Z","programNotes":[{"title":"培养目标及培养要求","text":"Referring to the international standard for medical education, the program of MBBS aims to educate international medical talents with solid medical knowledge, standard clinical skills and good professionalism while giving due consideration to the possible needs for them to serve in countries outside China. Students will acquire the capacity to work in medical and health institutions, making contributions to the areas of patient care, education and research. The program includes 4 stages: the first academic year is the stage of premedical study; the second and the third year are the stage of basic medical education, the forth and the fifth year are the stage of clinical medical education; and the last year is for clinical internship. The program is completely taught in English and follows the principle of consolidating academic basis, stressing technical skills, enhancing inter-discipline and conducting clinical practices."},{"title":"毕业要求及授予学位类型","text":"The program requires students to complete&nbsp;227.5&nbsp;credits (at least 59 credits for practice) in total throughout six academic years (43&nbsp;credits in premedical study and 184.5 credits in specialized course). Diploma will be conferred to those students who are successful in exam and the Bachelor of Medicine & Bachelor of Surgery (MBBS) will be granted to those who meet the requirements of the degree by Fudan University."}]}