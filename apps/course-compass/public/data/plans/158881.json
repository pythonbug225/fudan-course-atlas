eAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"春风化雨训练体系依托学院“春风化雨导师计划”面向本科轨道学生开展自选学术训练或实务训练，具体修读方式可对应参照本博融通、本硕融通轨道本科阶段项目调整后执行。\n本科毕业时，本科轨道学生可将学术或实务训练项目成果直接作为毕业论文申请送审，也可以单独撰写毕业论文。","reference":false,"referenceId":null,"courses":[{"code":"POLI40012","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"POLI40011","name":"社会实践","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"POLI30065","name":"科研实践Ⅰ","credits":4.0,"required":false,"term":"6,7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"POLI30066","name":"科研实践Ⅱ","credits":4.0,"required":false,"term":"6,7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":147,"completeModules":true,"fetchedAt":"2026-10-31T16:44:08Z","programNotes":[{"title":"学科专业简介","text":"复旦大学国际关系与公共事务学院成立于2000年11月，前身为1923年建立的复旦大学政治学系。百年政心赓续，问道政学、作育国士。目前拥有政治学和公共管理两个国家A类学科，是国家“双一流”学科建设单位，在世界大学专业排名中稳居前列。秉承“卓越为公”理念，培养新时代具有全球视野、国家意识和专业才能的领军人才。"},{"title":"培养目标","text":"秉持“宽口径、厚基础、重能力、求创新”的人才培养理念，本专业旨在培养具有政治学、公共行政学、公共政策、应急管理和人工智能等方面的基本理论和专门知识，能在党政机关、企事业单位、国际组织与社会团体等机构，从事政策分析及公共事务管理等工作的专门人才。"},{"title":"基本要求","text":"要求学生掌握马克思主义基本原理、公共行政学、管理学、经济学、政治学、国际政治学、法学和社会学的基本理论知识；掌握辩证唯物主义和历史唯物主义的基本观点和分析方法；了解有关国家治理、政府治理、社会治理与公共服务以及党政管理法律、制度、方针、政策；熟练掌握一门外语；了解公共行政学、公共政策、应急管理、社会保障、数字治理、全球治理等公共管理学科多个二级学科的发展动态；掌握文献检索、资料查询与调查研究的基本方法和手段，具有较强的科学研究能力和组织领导能力。\n"},{"title":"学分要求","text":"本方案仅供未分流港澳台侨生使用"},{"title":"学位要求","text":"本方案仅供未分流港澳台侨生使用"},{"title":"课程体系与科研训练体系","text":"\n1.课程体系以3门高难度、大学分的荣誉课程为基础建立本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。鼓励学生修读荣誉课程。2.训练体系春风化雨训练体系依托学院“春风化雨导师计划”面向本科轨道学生开展自选学术训练或实务训练，具体修读方式可对应参照本博融通、本硕融通轨道本科阶段项目调整后执行。本科毕业时，本科轨道学生可将学术或实务训练项目成果直接作为毕业论文申请送审，也可以单独撰写毕业论文。&nbsp;"}]}