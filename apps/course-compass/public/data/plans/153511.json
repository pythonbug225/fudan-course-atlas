0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"45","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"\"        要求至少修读本专业进阶课程15学分和1个辅修学士学位项目，辅修学士学位应与主修学士学位归属不同的本科专业大类。\n        辅修学士学位项目课程设置详见教务处辅修学士学位项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成辅修学士学位项目修读要求，且达到学校毕业和学位授予要求的学生可获得相应的辅修学士学位。\"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~32","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":10.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"10","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"ECON10001","name":"走进经济学系列讲座","credits":0.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON20002","name":"中国经济学系列讲座","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON10002","name":"数据分析方法应用初步","credits":3.0,"required":true,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECON30002","name":"科研实践（复芏计划）","credits":2.0,"required":false,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30003","name":"创新实践","credits":2.0,"required":false,"term":"6","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30005","name":"学术实践","credits":1.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON30004","name":"社会实践","credits":1.0,"required":false,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"ECON20010","name":"“经行天下”本科生专项社会实践","credits":1.0,"required":false,"term":"2","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECON40003","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":135,"completeModules":true,"fetchedAt":"2026-10-31T16:44:43Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; &nbsp; 复旦大学经济学院创建于1985年，其历史最早可以追溯到1917年复旦大学成立的商科与1922年成立的经济学系。现有理论经济学和应用经济学两个国家一级学科，其中理论经济学一级学科及金融学、产业经济学2个应用经济学二级学科为国家重点学科。经济学科秉承“经世济民、追求卓越”的理念，以先进的育人理念、雄厚的师资力量、和谐的管理氛围、优质的学术成果等优势被公认为国内最强的经济学科之一。财政学科建设它以经济学理论为基础，围绕公共经济理论发展以及国家财政、税收等宏观经济政策需求，与经济学、政治学、社会学、法学等多学科相互交叉渗透，是理论与实践并重，宏观与微观兼具的学科。"},{"title":"培养目标","text":"&nbsp;依托教育部基础学科拔尖学生培养计划2.0经济学拔尖学生培养基地，按照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2是通识和专业教育，X是多元发展路径，Y为融合创新能力）为途径，培养德智体美劳全面发展的财政学领军人才。学生应熟练掌握智能税务系统、数字化财务管理、财务决策支持等关键技术与工具，将财政学基础理论与智能技术融合，具有财政、税务、社会保障等理论知识和业务能力，并能在财税管理、公共政策咨询、企业税务风险管理、宏观分析与行业研究、国际税收管理、企业战略管理、投资顾问、数据分析、公司财务决策分析等领域从事相关工作。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"\n\n\n1.修业年限：4年（类型：本科）\n&nbsp;\n&nbsp;\n\n\n2. 学位授予说明：\n\n\n/\n/\n授予学位\n学位类型\n专业名称\n学段审核要求\n\n\n/\n/\n经济学学士学位\n/\n财政学\n□按照不少于总学分比例____%\n\n\n√按照不少于学分数 143\n\n\n√必修课组须通过\n通识教育课程40学分\n\n\n专业培养课程71学分\n\n\n专业进阶模块22学分&nbsp;\n\n\n融合创新能力模块10学分\n\n\n□其他____________________\n\n\n"},{"title":"学分要求","text":"\n&nbsp;\n\n\n\n1、 专业进阶路径：143学分\n\n\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 本路径学生需要完成143学分（含实践学分不低于32学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程40学分、专业培养课程71学分、专业进阶模块修读22学分、融合创新能力模块10学分。\n\n\n2、 本科荣誉项目：143学分\n\n\n&nbsp;&nbsp; 在专业进阶路径基础上，修读荣誉课程不少于6门课。荣誉项目课程设置和修读要求请见经济学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。鼓励学生选择荣誉项目。&nbsp;\n\n\n3、 跨学科学发展路径：151学分\n\n\n&nbsp;&nbsp; 本路径学生需要完成151学分，包括通识教育课程40学分、专业培养课程71学分、融合创新能力模块10学分、修读2个跨学科微专业30学分。\n\n\n4、财政学+AI双学士学位项目：178学分\n\n\n&nbsp;&nbsp; 具体要求见财政学-人工智能双学士学位项目培养方案。&nbsp;\n\n\n"},{"title":"学位要求","text":"\n\n\n1. 4年级结束时，如达到学士学位要求者理授予学学士学位。&nbsp;&nbsp;\n\n\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n\n\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n\n\n&nbsp;（3）在此基础上，达到经济学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见经济学院“本科荣誉项目”实施方案。\n\n\n2. 财政学+AI学士双学位项目，如达到财政学-人工智能双学士学位要求者授予经济学-工学双学士学位。\n\n\n"},{"title":"课程体系与科研训练体系","text":"\n\n\n\n1.课程体系\n\n\n&nbsp;&nbsp;&nbsp; 以经济学基础理论和数理基础和方法课程为基础建立了本研融通的专业核心课程体系，以学科领域为横、课程内容梯度为纵建立了难度逐级提升的本研融通的专业进阶课程体系。 鼓励学生修读荣誉课程。\n\n\n2.科研训练体系\n\n\n&nbsp; 建立螺旋递进的全周期科研训练体系，给低年级本科生配备学业导师／拔尖导师，鼓励师生共创，通过复芏计划等项目引导学生在“做中学、学中悟、悟中创”。在1、2年级设立“走进经济学系列讲座”和“中国经济学系列讲座”，覆盖全体本科生，引导学生深入了解中国经济现实和经济学研究的国际前沿，培育研究兴趣和提问能力。鼓励本科高年级通过学术实践和科研实践提升能力，助力学生完成复芏计划（FDUROP）项目（䇹政、望道、登辉和曦源），激发研究志趣。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内国际高水平创新竞赛（中国国际大学生创新大赛、“挑战杯”全国大学生课外学术科技作品竞赛等）。\n\n\n"},{"title":"课程设置与修读要求","text":"备注：每学期选修学分不得超过32学分。"}]}