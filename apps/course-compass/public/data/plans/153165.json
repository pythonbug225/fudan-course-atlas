ourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"3","rawId":"3","parent":null,"level":"1.1.1","title":"跨学科发展路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"28","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满28学分。两种完成途径：(A)修读专业进阶I和1个非本专业独立开设的微专业（学程）；或者(B)修读2个非本专业独立开设的微专业（学程）。学分不足部分可在全校开设的本科生课程中任意选修。完成跨学科发展路径(A)的学生可获得相应的微专业（学程）证书，可以向公共卫生学院申请推免直研资格，公共卫生学院为其提供专业排名；完成跨学科发展路径(B)的学生可获得相应的微专业（学程）证书，但不能向公共卫生学院申请推免直研资格，公共卫生学院也不为其提供专业排名。                \n微专业（学程）课程详见教务处微专业（学程）项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成微专业（学程）修读要求的学生可获得相应的微专业（学程）证书。","reference":false,"referenceId":null,"courses":[]},{"id":"5","rawId":"5","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"28","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满28学分。两种完成途径：(A)修读专业进阶I以及1个创新创业学院开设的创新创业微专业（学程）；或者(B)修读1个非本专业独立开设的微专业（学程）以及1个创新创业学院开设的创新创业微专业（学程）。学分不足部分可在全校所有本科生课程中任意选修。创新创业微专业（学程）课程详见教务处微专业（学程）项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成创新创业路径(A)的学生可向公共卫生学院申请推免直研资格，公共卫生学院为其提供专业排名。完成创新创业路径(B)的学生不能向公共卫生学院申请推免直研资格，公共卫生学院也不为其提供专业排名。","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requir