,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20018","name":"基础创新与应用（项目式）","credits":4.0,"required":true,"term":"2","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL40025","name":"本科毕业论文（设计）","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"CHEM10006","name":"有机化学实验I","credits":1.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20020","name":"技术集成与工程（项目式）","credits":4.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20011","name":"生物化学实验","credits":1.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL30030","name":"精益生产与标准化（项目式）","credits":4.0,"required":true,"term":"5","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20009","name":"细胞生物学与细胞工程实验","credits":1.0,"required":true,"term":"3","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL30031","name":"产品开发与应用（项目式）","credits":4.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20010","name":"微生物与微生物技术实验","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}},{"code":"BIOL20013","name":"遗传学与基因工程实验","credits":1.0,"required":true,"term":"4","rule":{"requiredCourse":false,"integrationCompulsory":false,"postGraduateDegreeType":null}}]}],"rowCount":85,"completeModules":true,"fetchedAt":"2026-10-31T16:45:14Z","programNotes":[{"title":"学科专业简介","text":"生物制造，作为物质合成的颠覆性技术，正开启继信息革命后的新经济浪潮。其实质是通过可编程的细胞工厂，驱动人类从“化石经济”迈向未来的“阳光经济”。复旦大学生物技术学院以校内基地—校外基地—境外基地—产业化平台（“三基地一平台”）协同联动为组织模式，聚焦合成生物学、基因编辑与AI驱动的细胞工厂构建及其应用，致力于突破传统资源生产物质的边界，实现从新分子发现到绿色智造的全流程创新，重塑医药与健康、粮食与农业、生物材料与能源环境等未来产业格局。学院由“双一流”和教育部评估A+学科生物学作为主建学科，联合生物医学工程、人工智能、基础医学、临床医学和药学等学科共建，并邀请数学、物理、化学、材料、信息技术、计算机等学科高水平师资联合开设课程和开展联合攻关。通过前沿科技与产业实战深度融合的沉浸式教学，构建有温度的教育体系，培养重塑物质文明的科技与产业革命者。&nbsp;"},{"title":"培养目标","text":"&nbsp; &nbsp; 聚焦国家生物制造和生物经济发展重大需求，依托生物技术学院“三基地一平台”，通过创设多学科交叉和科教、产教融合育人生态，推动“项目制”沉浸式教育教学改革，培养对生物制造前沿和产业变革需求有深度理解、面对复杂现实问题和未来前瞻问题能自主建构跨学科认知体系、兼具技术创新思维和工程转化能力的交叉复合人才，能够在医药健康、绿色制造、生物材料、现代农业及环境修复等领域从事生物制造体系设计、功能测试与迭代优化等相关工作，具备在生物制造底层理论、颠覆性技术或重大应用场景中形成突破性成果的潜力。"},{"title":"基本要求","text":"\n&nbsp;"},{"title":"修业要求","text":"本科生在4年级授予理学学士学位，学段审核要求按照不少于142学分数进行审核，且必修课组须通过，具体包括通识教育课程39学分、专业培养课程66学分、专业进阶模块课程12学分以及融合创新能力培养25学分。\n&nbsp;\n&nbsp;"},{"title":"学分要求","text":"\n&nbsp;"},{"title":"学位要求","text":"4年级结束时，如达到学士学位要求授予理学学士学位。 &nbsp;（1）本专业学生4年级结束时须完成142学分（含实践学分不低于36学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程39学分、专业培养课程66学分、专业进阶模块修读12学分、融合创新能力培养25学分（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。"},{"title":"课程体系与科研训练体系","text":""}]}