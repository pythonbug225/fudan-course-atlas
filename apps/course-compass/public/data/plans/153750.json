edCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"32","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"修满32学分。要求在本专业专业进阶模块I修读8学分、专业进阶模块II修读8学分、1个非本专业独立开设的微专业(学程)16学分，可选择学科微专业（学程）或跨学科微专业（学程）。学分不足部分可在全校所有本科生课程中任意选修。\n微专业（学程）课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。","reference":false,"referenceId":null,"courses":[]},{"id":"-105","rawId":"-105","parent":null,"level":"1.1.1","title":"创新创业路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-121","rawId":"-121","parent":null,"level":"1.1.1","title":"辅修学士学位路径","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"-100","rawId":"-100","parent":null,"level":"1.1.1","title":"其他","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":0.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"0","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2~23","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":10.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"10","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"JCM40001","name":"教学实习","credits":4.0,"required":true,"term":"7","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":1.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"106","name":"专业竞赛(本科阶段)","credits":1.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"1071","name":"校园媒体实践(本科阶段)","credits":1.0,"required":false,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM40003","name":"毕业论文","credits":4.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50029","name":"记录中国（专业实践）","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50004","name":"大江东—复旦融媒体创新工作室","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM50003","name":"新闻实务工作坊","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM40010","name":"社会调研与育人实践","credits":2.0,"required":false,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"JCM10005","name":"学生发展与生涯规划","credits":1.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":76,"completeModules":true,"fetchedAt":"2026-10-31T16:45:52Z","programNotes":[{"title":"学科专业简介","text":"复旦大学新闻学院前身为复旦大学新闻系，创办于1929年，是中国赓续历史最悠久的新闻传播教育机构，素有“复旦新闻馆，天下记者家”的美誉。近百年来，复旦新闻学院遵循“好学力行”的院训，作育国士，培养栋梁，形成了贯通本硕博的全链条人才培养体系。学院首批获得新闻传播学一级学科学位授予权，包含新闻学、传播学两个国家重点学科。拥有全国首家新闻传播学博士后流动站、国家级教材建设重点研究基地、教育部人文社会科学重点研究基地、教育部国际传播联合研究院、全球传播全媒体研究院等重要研究平台以及国家级实验教学示范中心。在最新一次全国学科评估中，复旦新闻传播学科被评为“A+”。学院与美国密苏里大学、英国伦敦政治经济学院、法国巴黎政治大学、澳大利亚墨尔本大学、荷兰阿姆斯特丹大学、日本早稻田大学等数十所世界一流新闻传播院校建立了紧密的人才培养和学术合作关系。近年来，按照“主流化、数字化、国际化”理念，全方位改革人才培养体系，推出望道新闻卓越班、数字视听、战略传播本硕融通项目，开设“新闻+AI”“传播+AI”双学位，培养堪当时代大任的创新型、复合型新闻传播人才。学院呼应智能时代发展趋势，推动科研范式创新，提升国际学术对话能力，打造一流新闻传播学科。\n&nbsp; &nbsp;"},{"title":"培养目标","text":"照“宽口径、厚基础、重能力、求创新”的人才培养要求，以“2+X+Y”（2 是通识和专业教育，X 是多元发展路径，Y 为融合创新能力）为途径，以主流化、数字化、国际化为人才培养理念，培养政治立场坚定、方向明确，兼具传播学与社会学双重卓越素养的应用型、创新型、复合型精英人才。学生需夯实坚实的科学素养基础，厚植深厚的人文社会科学底蕴，全面掌握传播学专业知识体系，包括传播理论、媒介与技术、跨文化传播等领域，深入理解传播行为与媒介运作的规律；同时，透彻领会社会学核心要义，精通社会结构、文化社会学、社会变迁等理论，熟练运用社会调查研究方法，如问卷调查、深度访谈、参与观察等，以精准分析复杂社会现象，明察社会问题的本质，并探索社会行为背后的深层逻辑。通过课程学习和实际项目设计，学生将形成高度的学术敏感性和实践能力，为适应瞬息万变的全球化传播环境和复杂多变的社会动态奠定坚实基础。"},{"title":"基本要求","text":""},{"title":"修业要求","text":"1.修业年限：4年（类型：本科）\n"},{"title":"学分要求","text":"\n1、专业进阶路径：167学分&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;\n本路径学生需要完成167学分（含实践学分不低于26学分；含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动；劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程38学分、专业培养课程87学分、专业进阶模块32学分、融合创新能力培养10学分。\n2、本科荣誉项目：167学分&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;\n荣誉项目课程设置和修读要求请见新闻学院“本科荣誉项目”实施方案。下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。\n3、跨学科学发展路径：167学分&nbsp;\n微专业（学程）课程详见教务处学程项目网页，下载地址：https://jwc.fudan.edu.cn/（复旦大学教务处）专业培养-常用文档。完成微专业（学程）修读要求的学生可获得相应的微专业（学程）证书。"},{"title":"学位要求","text":"4年级结束时，如达到学士学位要求者授予文学、法学双学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到新闻学院“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见新闻学院“本科荣誉项目”实施方案。"},{"title":"课程体系与科研训练体系","text":""}]}