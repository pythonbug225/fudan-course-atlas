ourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"14","requireAny":true,"requireAll":false},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"54","name":"科研轮转","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"51","name":"无学分科研实践","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"7","name":"国际交流","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"8","name":"专业外语","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"2","name":"博士生资格考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"1","name":"博士学位论文开题","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"3","name":"博士论文中期考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"6","name":"博士学位论文预审","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHAR30006","name":"专业实习","credits":2.0,"required":true,"term":"暑期","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHAR40006","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHAR40012","name":"综合性药学实验","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":142,"completeModules":true,"fetchedAt":"2026-10-31T16:46:01Z","programNotes":[{"title":"学科专业简介","text":"复旦大学药学院历史悠久，起步于1936年的国立上海医学院药学专修科，是我国顶尖的药学教育机构之一。2017年，药学学科入选教育部首批“双一流”建设学科，并于2022年再次入选第二轮双一流学科建设名单，2019年入选第一批国家级一流本科专业建设点，2021年入选第一批教育部药学拔尖学生培养计划2.0基地。复旦大学“药理学与毒理学”学科2018年首次进入ESI世界排名前1‰后，排名稳步上升，2025年12月的世界排名为第16位，中国第6位。在U.S.News的排名为世界第3位，中国第1位。复旦大学“药学与药理学”学科的QS世界大学排名为第41位，中国第4位。&nbsp;&nbsp;&nbsp;药学院学科齐全，药学一级学科下设7个二级学科，药物化学、微生物与生化药学、药理学、药剂学、药物分析学，生药学与天然药物化学以及临床药学。学科体系完整，基础扎实。其中药剂学科为国家重点学科，药理学科为上海市重点学科。拥有克服屏障高端制剂全国重点实验室和智能化递药教育部重点实验室等国家和省部级科研平台。"},{"title":"培养目标","text":"&nbsp;本专业旨在培养具备创新药物研发能力的高层次人才，能够在药物研发领域发挥引领作用。要求学生具备扎实的药学理论基础、活跃的创新思维能力、灵活的解决复杂问题的能力以及良好的职业道德素养。通过多学科的课程设置和丰富的实践项目，引导学生跨越学科界限，融合不同领域的知识，追踪前沿技术与行业动态。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"&nbsp;\n本路径学生本博期间必须修满教学计划规定的 167学分，包括通识教育课程43学分、专业培养课程77学分、专业进阶I课程12学分、专业进阶II课程21学分（含跨一级学科选修课2学分），融合创新能力培养14学分。本博融通的学生需至少选修4门荣誉课程（可替换普通课程学分）。其中，本科学段需要完成 146学分（含实践学分不低于36.5学分、含美育学分不少于 2 学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读 1 学分，并至少参与一项艺术实践活动、劳动教育不少于32学时，并满足劳动周教育要求），包括通识教育课程 39 学分、专业培养课程 77 学分、专业进阶模块20学分、融合创新能力培养10 学分。"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予理学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n（3）在此基础上，达到药学“本科荣誉证书”获得条件的授予“本科荣誉证书”，具体要求请见药学“本科荣誉项目”实施方案。\n2. 本科学段主动退出和转段考核不合格退出本博融通计划的学生，需按照药学专业本科“2+X+Y”培养方案修读课程，如达到学士学位要求者授予理学学士学位。\n（二）研究生学位\n1. 达到博士学位要求者授予理学博士学位。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;（1）博士学位申请人提出学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于 2.5。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;（2）学位授予标准院系补充说明：按照《复旦大学学位授予工作细则》、《复旦大学博士学位基本要求》及《药学院博士学位授予标准》的相关规定执行。\n2. 研究生学段主动退出和博士生资格考核不合格退出本博融通计划的学生，需按照药学学术学位硕士生培养方案修读课程，如达到硕士学位要求者授予相应硕士学位。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;（1）硕士学位申请人提出学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于 2.5。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;（2）硕士学位授予标准院系补充说明：按照《复旦大学学位授予工作细则》、《复旦大学硕士学位基本要求》及《1007药学硕士学位授予标准》的相关规定执行。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n\n2.科研训练体系\n本博融通计划学生在二年级，将在2~3个不同的研究团队中进行轮转实习，每个团队为期8周，以拓宽科研视野。三年级，学生将确定自己的科研方向，并在此基础上完成毕业论文，深化科研实践能力。\n本科期间需要承担至少1项院级及院级以上科创项目（含药育新才、曦源、望道、莙政、卿枫、复芏计划(FDUROP)、药苑论坛、挑战杯、中国国际大学生创新大赛等），学院为其配置学术导师进行指导。"}]}