d":true,"term":"6","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECOL50020","name":"生态学科研综合训练Ⅲ","credits":3.0,"required":false,"term":"5","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECOL30003","name":"生物学野外实习","credits":2.0,"required":true,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BIOL50055h","name":"生物科学研究设计与实践（上）(H)","credits":2.0,"required":false,"term":"秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"ECOL30011","name":"生态学野外实习","credits":1.0,"required":true,"term":"暑期","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BIOL50056h","name":"生物科学研究设计与实践（中）(H)","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BIOL50057h","name":"生物科学研究设计与实践（下）(H)","credits":2.0,"required":false,"term":"春,秋","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"BIOL30001","name":"毕业论文","credits":2.0,"required":true,"term":"8","rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}}]}],"rowCount":97,"completeModules":true,"fetchedAt":"2026-10-31T16:45:09Z","programNotes":[{"title":"学科专业简介","text":"复旦大学在生态学和人工智能领域均拥有深厚的学科基础和卓越的师资力量。复旦大学“生态学＋人工智能”项目依托生命科学学院和计算机科学技术学院的深厚资源，致力于培养具备跨学科知识和创新能力的复合型人才。生态学方面，复旦大学生态学科拥有悠久的历史和卓越的学术声誉，师资力量和科研实力雄厚，涵盖了基础理论生态学、生物多样性保护与生态智能监测、全球变化与可持续应对等多个领域，覆盖面极广。复旦大学生态学为A级学科，拥有国家重点学科、一级学科博士点、全国重点实验室、国家野外观测研究台站、教育部重点实验室和野外实践教育基地等支持平台，已成为国内领先、国际一流的人才培养和科研高地。人工智能方面，复旦大学计算机科学技术学院也是国内领先的研究机构，主要包括机器学习、自然语言处理、计算机视觉等多个前沿方向。在计算机科学研究机构排名榜单 CSRankings 中，复旦大学在 AI 方向近五年（2018--2022）全球排名第 16 位，2021--2022 年全球排名第 14 位。人才培养方面， “生态学＋人工智能”项目预期通过跨学科的课程设计和实践训练，使学生掌握生态学和人工智能领域的基本知识和技能，并具备突出的多学科融合创新能力。项目预期培养出一批既精通生态学原理与应用基本理论又掌握人工智能技术的复合型人才，为我国生态文明建设与可持续发展目标的实现提供人才保障。"},{"title":"培养目标","text":"本专业对接国家“新工科”和交叉学科发展的战略需求，致力于培养德智体美劳全面发展，具备扎实的生态学基础知识和前沿的人工智能技术，能够融合生态学与人工智能领域的核心理论，开阔的国际视野与跨文化交流合作能力，熟悉生态学相关领域的发展现状和前沿趋势，洞察国家生态文明重大战略相关领域的需求，具备突出的科学研究能力和融合创新能力，在生态学和人工智能的前沿交叉领域的原始创新上取得突破的拔尖人才和融合创新高端应用人才。要求学生掌握生态学和人工智能学科的基础知识，系统学习生态学的基本理论和实验技能，深入理解人工智能的核心概念、原理和技术方法，形成扎实的跨学科理论基础；具备较强的跨学科融合创新能力，运用生态学和人工智能的知识，解决生物多样性保护、智能生态环境监测、气候变化应对与“碳中和”目标实现等领域的实际问题；具有良好的国际视野和跨文化交际能力，能够适应国际交流合作的需要；具备较强的实践能力和创新精神具有良好的职业道德和社会责任感，树立正确的价值观和职业观，具备高度的职业道德和社会责任感，能够为社会做出积极的贡献。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"本专业学生毕业时须满足通识教育课程（含通识教育核心课程和专项教育课程）36学分、专业培养课程89学分，多元发展路径课程24学分，融合创新能力培养模块26学分，总学分不低于175学分（含实践学分不低于46学分，含美育学分不少于2学分，其中至少在“美学和艺术史论类”或“艺术鉴赏和评论类”课程中修读1学分，并至少参与一项艺术实践活动、劳动教育不少于42学时，并满足劳动周教育要求），达到学位要求者授予理学学士学位和工学学士学位。"},{"title":"学位要求","text":"达到学位要求者授予授予理学学士学位和工学学士学位。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n生态学学科整体课程安排遵循由理论基础深入到专业知识，兼顾科学素养培养和实践能力训练，结合宏观和微观，强调学科前沿进展的思路。在各个研究方向上安排本科生基础课程和前沿课程，营造教学和科研并重的创新型学习环境。\n备注：1）课程代码数字部分的第一位代表了课程难度/深度等级。\n&nbsp; &nbsp; 2）每学期选修学分不得超过32学分。\n2. 科研训练体系\n本科阶段设立生命科学交叉前沿专题，引导学生早进课题组轮转，通过“复芏计划”激发创新志趣。研究生阶段强化科研训练，加强科学道德和学术规范教育，激励学生自主开展学术研究。多渠道支持学生参加国内国际高水平学术交流，鼓励学生参加国内外高水平创新竞赛，以赛促教、促学、促研。\n"}]}