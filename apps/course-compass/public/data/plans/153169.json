equiredCredits":"0","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[]},{"id":"2","rawId":"2","parent":null,"level":"1.1","title":"融合创新能力","type":null,"rule":{"requiredSubModuleNum":0,"requiredCredits":16.0,"postCreditsRequired":0.0,"postRequiredCourseNum":0,"integrationCreditsRequired":0.0,"integrationRequiredCourseNum":0,"requiredCourseNum":0,"autoSubModuleNum":false,"showRequiredCredits":"16","requireAll":false,"requireAny":true},"limit":{"creditsUpperLimit":null,"courseNumUpperLimit":null},"note":"","reference":false,"referenceId":null,"courses":[{"code":"54","name":"科研轮转","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"51","name":"无学分科研实践","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"4","name":"研究生学术活动","credits":2.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"5","name":"研究生实践活动","credits":4.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"11","name":"硕士学位论文开题","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"31","name":"硕士论文中期考核","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"61","name":"硕士学位论文预审","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"102","name":"复芏计划(FDUROP)","credits":0.0,"required":true,"term":null,"rule":{"requiredCourse":null,"integrationCompulsory":null,"postGraduateDegreeType":null}},{"code":"PHAR30006","name":"专业实习","credits":2.0,"required":true,"term":"暑期","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHAR40006","name":"毕业论文","credits":6.0,"required":true,"term":"8","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}},{"code":"PHAR40012","name":"综合性药学实验","credits":2.0,"required":true,"term":"7","rule":{"requiredCourse":false,"integrationCompulsory":true,"postGraduateDegreeType":null}}]}],"rowCount":97,"completeModules":true,"fetchedAt":"2026-10-31T16:46:01Z","programNotes":[{"title":"学科专业简介","text":"&nbsp; 复旦大学药学院历史悠久，起步于1936年的国立上海医学院药学专修科，是我国顶尖的药学教育机构之一。2017年，药学学科入选教育部首批“双一流”建设学科，并于2022年再次入选第二轮双一流学科建设名单，2019年入选第一批国家级一流本科专业建设点，2021年入选第一批教育部药学拔尖学生培养计划2.0基地。复旦大学“药理学与毒理学”学科2018年首次进入ESI世界排名前1‰后，排名稳步上升，2025年12月的世界排名为第16位，中国第6位。在U.S.News的排名为世界第3位，中国第1位。复旦大学“药学与药理学”学科的QS世界大学排名为第41位，中国第4位。&nbsp;&nbsp;&nbsp;&nbsp;药学院学科齐全，药学一级学科下设7个二级学科，药物化学、微生物与生化药学、药理学、药剂学、药物分析学，生药学与天然药物化学以及临床药学。学科体系完整，基础扎实。其中药剂学科为国家重点学科，药理学科为上海市重点学科。拥有克服屏障高端制剂全国重点实验室和智能化递药教育部重点实验室等国家和省部级科研平台。"},{"title":"培养目标","text":"本专业依托多学科交叉与产教融合，培养具备坚实药学基础、跨学科创新能力和国际视野，能够在新药发现、制剂与递送系统开发、药效与安全性评价及成果转化等领域独立开展研究、引领创新的高层次复合型人才。"},{"title":"基本要求","text":""},{"title":"学分要求","text":"\n新药研究与开发专业学位路径：155学分\n本路径学生本硕期间必须修满教学计划规定的155学分。包括通识教育课程（含通识教育核心课程和专项教育课程）42学分、学科基础课21学分，专业核心课程56学分（须至少选修2门荣誉课程，可替换普通课程学分）、专业进阶模块I课程12学分、专业进阶模块II课程8学分、融合创新16学分的修读。达到学位要求者授予药学硕士学位。\n&nbsp;"},{"title":"学位要求","text":"（一）本科学位\n1. 4年级结束时，如达到学士学位要求者授予理学学士学位。\n（1）修满规定的学分，达到本科教学培养方案规定的各项要求。\n（2）以符合学生毕业时所在专业教学培养方案规定的所有课程的有效成绩为准计算平均绩点，且此平均绩点大于或等于2.0。\n2. 本科学段主动退出和转段考核不合格退出本硕融通计划的学生，需按照本专业本科“2+X+Y”培养方案修读课程，如达到学士学位要求者授予理学学士学位。\n（二）研究生学位\n达到硕士学位要求者授予药学硕士学位：1. 硕士学位申请人提出学位论文答辩申请时，必须已修满学校规定的学分；所有修读课程成绩合格，其中学位课程平均绩点原则上不低于 2.5。 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2. 硕士学位授予标准院系补充说明：按照《复旦大学学位授予工作细则》的规定执行。"},{"title":"课程体系与科研训练体系","text":"1.课程体系\n\n2.科研训练体系\n&nbsp; 针对本硕融通计划学生在第三年下学期，学生将在两个不同的研究团队中进行轮转实习，每个团队为期8周，以拓宽科研视野。第四年，学生将确定自己的科研方向，并在此基础上完成毕业论文，深化科研实践能力。\n&nbsp; 本科期间需要承担至少1项院级及院级以上科创项目（含药育新才、曦源、望道、莙政、卿枫、复芏计划(FDUROP)、药苑论坛、挑战杯、中国国际大学生创新大赛等），学院为其配置学术导师进行指导。"}]}